@@ -0,0 +1,73 @@
+// Copyright 2026 LuoboIM contributors.
+// SPDX-License-Identifier: Apache-2.0
+
+package conversation_msg
+
+import (
+	"context"
+	"errors"
+	"reflect"
+	"strings"
+	"testing"
+)
+
+func TestLocalClearPartialFailureIsNotReportedAsSuccess(t *testing.T) {
+	for _, failed := range []string{"first", "middle", "last", "all"} {
+		t.Run(failed, func(t *testing.T) {
+			ids := []string{"first", "middle", "last"}
+			var attempted, notified []string
+			calls := 0
+			ctx := context.WithValue(context.Background(), clearBatchContextKey{}, "frozen-owner")
+			err := clearLocalConversationBatch(ctx, ids, func(received context.Context, id string) error {
+				if received != ctx {
+					t.Fatal("operation context was replaced")
+				}
+				attempted = append(attempted, id)
+				if failed == "all" || failed == id {
+					return errors.New("secret-db-error-with-message-and-conversation")
+				}
+				return nil
+			}, func(successes []string) {
+				calls++
+				notified = append(notified, successes...)
+			})
+			if err == nil || !strings.Contains(err.Error(), "local message clear incomplete") || strings.Contains(err.Error(), "secret-db-error") {
+				t.Fatalf("expected fixed safe partial-result error, got %v", err)
+			}
+			if !reflect.DeepEqual(attempted, ids) || calls != 1 {
+				t.Fatalf("all conversations must be attempted before one notification: %v/%d", attempted, calls)
+			}
+			var want []string
+			for _, id := range ids {
+				if failed != "all" && failed != id {
+					want = append(want, id)
+				}
+			}
+			if !reflect.DeepEqual(notified, want) {
+				t.Fatalf("notification contains unconfirmed clears: %v, want %v", notified, want)
+			}
+		})
+	}
+}
+
+type clearBatchContextKey struct{}
+
+func TestLocalClearSuccessfulAndEmptyBatch(t *testing.T) {
+	for _, ids := range [][]string{nil, {"one", "two"}} {
+		t.Run(map[bool]string{true: "empty", false: "all_success"}[len(ids) == 0], func(t *testing.T) {
+			attempts, notifications := 0, 0
+			err := clearLocalConversationBatch(context.Background(), ids, func(context.Context, string) error {
+				attempts++
+				return nil
+			}, func(successes []string) {
+				notifications++
+				if len(successes) != len(ids) {
+					t.Fatalf("successful batch notification lost rows: %v", successes)
+				}
+			})
+			if err != nil || attempts != len(ids) || notifications != 1 {
+				t.Fatalf("complete or empty batch should succeed: %v/%d/%d", err, attempts, notifications)
+			}
+		})
+	}
+}
