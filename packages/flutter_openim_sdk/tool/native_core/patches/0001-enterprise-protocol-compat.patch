@@ -0,0 +1,35 @@
+// Package diagnostics discards legacy content-bearing logs at their source boundary.
+// Its API is intentionally incapable of enabling request, SQL, token or payload logs.
+// Applications may report explicit, enumerated safe events outside the native core.
+package diagnostics
+
+import (
+	"context"
+	"gorm.io/gorm/logger"
+	"time"
+)
+
+func InitFromConfig(...any) error                   { return nil }
+func ZDebug(context.Context, string, ...any)        {}
+func ZInfo(context.Context, string, ...any)         {}
+func ZWarn(context.Context, string, error, ...any)  {}
+func ZError(context.Context, string, error, ...any) {}
+func Debug(...any)                                  {}
+func Info(...any)                                   {}
+func Warn(...any)                                   {}
+func Error(...any)                                  {}
+func NewDebug(...any)                               {}
+func NewInfo(...any)                                {}
+func NewError(...any)                               {}
+func Printf(...any)                                 {}
+
+// GORM must never render SQL text, even when a caller changes LogMode.
+func NewSqlLogger(logger.LogLevel, bool, time.Duration) logger.Interface { return silentSQL{} }
+
+type silentSQL struct{}
+
+func (silentSQL) LogMode(logger.LogLevel) logger.Interface                        { return silentSQL{} }
+func (silentSQL) Info(context.Context, string, ...any)                            {}
+func (silentSQL) Warn(context.Context, string, ...any)                            {}
+func (silentSQL) Error(context.Context, string, ...any)                           {}
+func (silentSQL) Trace(context.Context, time.Time, func() (string, int64), error) {}
