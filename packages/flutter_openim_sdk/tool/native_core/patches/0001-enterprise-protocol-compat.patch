+++ b/cmd/facade_wire_fixture/main.go
@@ -0,0 +1,221 @@
+// Standalone loopback-only synthetic JNI protocol fixture. No real credentials.
+package main
+
+import (
+	"bytes"
+	"compress/gzip"
+	"encoding/gob"
+	"encoding/json"
+	"fmt"
+	"github.com/OpenIMSDK/protocol/rtc"
+	"github.com/OpenIMSDK/protocol/sdkws"
+	"github.com/gorilla/websocket"
+	"google.golang.org/protobuf/proto"
+	"io"
+	"net/http"
+	"os"
+	"sync"
+	"time"
+)
+
+type envelope struct {
+	ReqIdentifier        int32
+	MsgIncr, OperationID string
+	ErrCode              int
+	ErrMsg               string
+	Data                 []byte
+}
+
+var mu sync.Mutex
+var seen = map[string]bool{}
+
+func record(s string) {
+	mu.Lock()
+	defer mu.Unlock()
+	seen[s] = true
+	data, _ := json.MarshalIndent(map[string]any{"synthetic_only": true, "operations": seen}, "", "  ")
+	os.WriteFile("../facade-wire-result.json", data, 0600)
+	fmt.Println("SYNTHETIC_OPERATION", s)
+}
+func main() {
+	up := websocket.Upgrader{CheckOrigin: func(*http.Request) bool { return true }}
+	http.HandleFunc("/", func(w http.ResponseWriter, r *http.Request) {
+		if !websocket.IsWebSocketUpgrade(r) {
+			var req map[string]any
+			json.NewDecoder(r.Body).Decode(&req)
+			var data any = map[string]any{}
+			status := 0
+			if r.Header.Get("token") != "fixture-no-real-credentials" {
+				status = 10001
+			}
+			switch r.URL.Path {
+			case "/user/update_user_info_ex":
+				user, _ := req["userInfo"].(map[string]any)
+				if user["userID"] != "luobo_schema_fixture" {
+					status = 10001
+				}
+				record("self-info")
+			case "/signal/signal_get_room_by_group_id":
+				data = map[string]any{"roomID": "fixture-room", "participantIDs": []string{"luobo_schema_fixture"}}
+				record("room")
+			case "/signal/get_signal_invitation_info_start_app":
+				data = map[string]any{"invitation": map[string]any{"roomID": "fixture-room"}}
+				if req["userID"] != "luobo_schema_fixture" {
+					status = 10001
+				}
+				record("restore")
+			case "/signal/signal_get_meetings":
+				data = map[string]any{"meetingList": []any{map[string]any{"roomID": "fixture-room"}}}
+				if req["userID"] != "luobo_schema_fixture" {
+					status = 10001
+				}
+				record("meetings")
+			case "/signal/signal_create_meeting", "/signal/signal_join_meeting":
+				participant, _ := req["participant"].(map[string]any)
+				user, _ := participant["userInfo"].(map[string]any)
+				if user["userID"] != "luobo_schema_fixture" {
+					status = 10001
+				}
+				data = map[string]any{"roomID": "fixture-room", "token": "synthetic-media-token", "liveURL": "wss://synthetic.invalid"}
+				record(r.URL.Path)
+			case "/signal/signal_operate_stream":
+				if req["userID"] != "target-peer" || req["mute"] != true {
+					status = 10001
+				}
+				record("stream-target")
+			case "/signal/signal_send_custom_signal":
+				if req["customInfo"] != "synthetic-custom" || req["roomID"] != "fixture-room" {
+					status = 10001
+				}
+				record("custom-order")
+			case "/signal/signal_close_room", "/signal/signal_update_meeting_info":
+				record(r.URL.Path)
+			case "/msg/get_group_message_has_read":
+				if req["type"] != float64(0) {
+					status = 10001
+				}
+				data = map[string]any{"reads": []any{map[string]any{"userID": "fixture-peer", "readTime": 123}}}
+				record("group-readers")
+			case "/group/get_group_members_info":
+				data = map[string]any{"members": []any{map[string]any{"groupID": "fixture-group", "userID": "fixture-peer", "nickname": "Synthetic Peer"}}}
+			case "/msg/mark_group_message_read":
+				m, _ := req["clientMsgs"].(map[string]any)
+				if req["userID"] != "luobo_schema_fixture" || m["fixture-group-message"] != "fixture-peer" {
+					status = 10001
+				}
+				record("group-mark")
+			}
+			json.NewEncoder(w).Encode(map[string]any{"errCode": status, "data": data})
+			return
+		}
+		c, e := up.Upgrade(w, r, nil)
+		if e != nil {
+			return
+		}
+		defer c.Close()
+		compressed := r.URL.Query().Get("compression") == "gzip"
+		var write sync.Mutex
+		send := func(m envelope) {
+			var b bytes.Buffer
+			gob.NewEncoder(&b).Encode(m)
+			data := b.Bytes()
+			if compressed {
+				var z bytes.Buffer
+				g := gzip.NewWriter(&z)
+				g.Write(data)
+				g.Close()
+				data = z.Bytes()
+			}
+			write.Lock()
+			defer write.Unlock()
+			c.WriteMessage(websocket.BinaryMessage, data)
+		}
+		go func() {
+			time.Sleep(time.Second)
+			inv := &rtc.InvitationInfo{InviterUserID: "fixture-peer", InviteeUserIDList: []string{"luobo_schema_fixture"}, RoomID: "fixture-room", Timeout: 30, MediaType: "audio", PlatformID: 2, SessionType: 1, InitiateTime: time.Now().Unix()}
+			messages := []proto.Message{&rtc.SignalReq{Payload: &rtc.SignalReq_Invite{Invite: &rtc.SignalInviteReq{UserID: "fixture-peer", Invitation: inv}}}, &rtc.SignalOnRoomParticipantConnectedReq{Invitation: inv}, &rtc.SignalOnRoomParticipantDisconnectedReq{Invitation: inv}, &rtc.SignalOnStreamChangeReq{RoomID: "fixture-room", StreamType: "audio", Mute: true}, &rtc.SignalSendCustomSignalReq{RoomID: "fixture-room", CustomInfo: "fixture"}}
+			for i, p := range messages {
+				content, _ := proto.Marshal(p)
+				msg := &sdkws.MsgData{SendID: "fixture-peer", RecvID: "luobo_schema_fixture", ClientMsgID: fmt.Sprintf("rtc-facade-%d", i), SessionType: 1, MsgFrom: 200, ContentType: int32(1601 + i), Content: content, SendTime: time.Now().UnixMilli(), CreateTime: time.Now().UnixMilli(), Options: map[string]bool{}}
+				push := &sdkws.PushMessages{NotificationMsgs: map[string]*sdkws.PullMsgs{"sn_fixture-peer_luobo_schema_fixture": {Msgs: []*sdkws.MsgData{msg}}}}
+				data, _ := proto.Marshal(push)
+				send(envelope{ReqIdentifier: 2001, OperationID: "synthetic-push", Data: data})
+				time.Sleep(100 * time.Millisecond)
+			}
+		}()
+		for {
+			_, data, e := c.ReadMessage()
+			if e != nil {
+				return
+			}
+			if compressed {
+				g, e := gzip.NewReader(bytes.NewReader(data))
+				if e != nil {
+					return
+				}
+				data, e = io.ReadAll(g)
+				g.Close()
+				if e != nil {
+					return
+				}
+			}
+			var req envelope
+			if gob.NewDecoder(bytes.NewReader(data)).Decode(&req) != nil {
+				return
+			}
+			resp := envelope{ReqIdentifier: req.ReqIdentifier, MsgIncr: req.MsgIncr, OperationID: req.OperationID}
+			if req.ReqIdentifier == 1004 {
+				var signal rtc.SignalReq
+				if proto.Unmarshal(req.Data, &signal) != nil {
+					return
+				}
+				var result rtc.SignalResp
+				actor := ""
+				name := ""
+				switch p := signal.Payload.(type) {
+				case *rtc.SignalReq_Invite:
+					actor = p.Invite.UserID
+					name = "invite"
+					if p.Invite.Invitation.InviterUserID != "luobo_schema_fixture" || p.Invite.Invitation.PlatformID != 2 {
+						resp.ErrCode = 10001
+					}
+					result.Payload = &rtc.SignalResp_Invite{Invite: &rtc.SignalInviteResp{RoomID: "fixture-room", Token: "synthetic-media-token", LiveURL: "wss://synthetic.invalid"}}
+				case *rtc.SignalReq_InviteInGroup:
+					actor = p.InviteInGroup.UserID
+					name = "inviteInGroup"
+					result.Payload = &rtc.SignalResp_InviteInGroup{InviteInGroup: &rtc.SignalInviteInGroupResp{RoomID: "fixture-room", Token: "synthetic-media-token", LiveURL: "wss://synthetic.invalid"}}
+				case *rtc.SignalReq_Accept:
+					actor = p.Accept.UserID
+					name = "accept"
+					if p.Accept.OpUserPlatformID != 2 {
+						resp.ErrCode = 10001
+					}
+					result.Payload = &rtc.SignalResp_Accept{Accept: &rtc.SignalAcceptResp{RoomID: "fixture-room", Token: "synthetic-media-token", LiveURL: "wss://synthetic.invalid"}}
+				case *rtc.SignalReq_Reject:
+					actor = p.Reject.UserID
+					name = "reject"
+				case *rtc.SignalReq_Cancel:
+					actor = p.Cancel.UserID
+					name = "cancel"
+				case *rtc.SignalReq_HungUp:
+					actor = p.HungUp.UserID
+					name = "hangup"
+				case *rtc.SignalReq_GetTokenByRoomID:
+					actor = p.GetTokenByRoomID.UserID
+					name = "token"
+					result.Payload = &rtc.SignalResp_GetTokenByRoomID{GetTokenByRoomID: &rtc.SignalGetTokenByRoomIDResp{Token: "synthetic-media-token", LiveURL: "wss://synthetic.invalid"}}
+				}
+				if actor != "luobo_schema_fixture" {
+					resp.ErrCode = 10001
+				}
+				resp.Data, _ = proto.Marshal(&rtc.SignalMessageAssembleResp{SignalResp: &result})
+				record("ws-" + name)
+			}
+			send(resp)
+		}
+	})
+	fmt.Println("FACADE_FIXTURE_LISTENING 18770")
+	if err := http.ListenAndServe("127.0.0.1:18770", nil); err != nil {
+		panic(err)
+	}
+}
