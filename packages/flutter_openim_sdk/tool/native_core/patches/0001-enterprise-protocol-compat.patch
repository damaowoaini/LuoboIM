+package util
+
+import (
+	"context"
+	"encoding/json"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/ccontext"
+	"github.com/openimsdk/openim-sdk-core/v3/sdk_struct"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync/atomic"
+	"testing"
+)
+
+func apiTestContext(base string, test bool) context.Context {
+	return ccontext.WithOperationID(ccontext.WithInfo(context.Background(), &ccontext.GlobalConfig{UserID: "alice", Token: "synthetic-token", IMConfig: sdk_struct.IMConfig{ApiAddr: base, AllowInsecureLoopbackForTesting: test}}), "synthetic-op")
+}
+func TestCompatAPIRedirectNeverForwardsToken(t *testing.T) {
+	var reached atomic.Int32
+	target := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { reached.Add(1) }))
+	defer target.Close()
+	source := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		http.Redirect(w, r, target.URL, http.StatusTemporaryRedirect)
+	}))
+	defer source.Close()
+	if err := ApiPost(apiTestContext(source.URL, true), "/route", map[string]any{}, nil); err == nil {
+		t.Fatal("redirect accepted")
+	}
+	if reached.Load() != 0 {
+		t.Fatal("credential-bearing redirect followed")
+	}
+}
+func TestCompatAPISafeErrorsAndCancellation(t *testing.T) {
+	var calls atomic.Int32
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		calls.Add(1)
+		if r.URL.Path != "/api/route" || r.Header.Get("token") != "synthetic-token" {
+			t.Error("route or authentication lost")
+		}
+		json.NewEncoder(w).Encode(map[string]any{"errCode": 10001, "errMsg": "PRIVATE-PAYLOAD", "errDlt": "PRIVATE-TOKEN"})
+	}))
+	defer server.Close()
+	err := ApiPost(apiTestContext(server.URL+"/api/", true), "/route", nil, nil)
+	if err == nil || strings.Contains(err.Error(), "PRIVATE") {
+		t.Fatal("server content escaped in error")
+	}
+	if err := ApiPost(apiTestContext(server.URL, false), "/route", nil, nil); err == nil {
+		t.Fatal("insecure default accepted")
+	}
+	ctx, cancel := context.WithCancel(apiTestContext(server.URL, true))
+	cancel()
+	if err := ApiPost(ctx, "/route", nil, nil); err == nil {
+		t.Fatal("cancelled request accepted")
+	}
+	if calls.Load() != 1 {
+		t.Fatal("rejected request dispatched")
+	}
+}
+func TestCompatAPIOversizedAndMalformedResponse(t *testing.T) {
+	for _, body := range []string{"not-json", `{"errCode":0,"data":"wrong-shape"}`, strings.Repeat("x", (16<<20)+1)} {
+		server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { io.WriteString(w, body) }))
+		var response struct{ Value string }
+		if err := ApiPost(apiTestContext(server.URL, true), "/route", nil, &response); err == nil {
+			t.Fatal("malformed response accepted")
+		}
+		server.Close()
+	}
+}
