+package group
+
+import (
+	"context"
+	"encoding/json"
+	"github.com/openimsdk/openim-sdk-core/v3/open_im_sdk_callback"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/ccontext"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/common"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/db"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/db/db_interface"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/db/model_struct"
+	"github.com/openimsdk/openim-sdk-core/v3/sdk_struct"
+	"net/http"
+	"net/http/httptest"
+	"sync"
+	"sync/atomic"
+	"testing"
+)
+
+type concurrentGroupReads struct {
+	db_interface.DataBase
+	snapshots sync.WaitGroup
+}
+
+func (d *concurrentGroupReads) GetGroups(ctx context.Context, ids []string) ([]*model_struct.LocalGroup, error) {
+	rows, err := d.DataBase.GetGroups(ctx, ids)
+	d.snapshots.Done()
+	d.snapshots.Wait()
+	return rows, err
+}
+
+type addedGroupCapture struct {
+	open_im_sdk_callback.OnGroupListener
+	count atomic.Int32
+}
+
+func (c *addedGroupCapture) OnJoinedGroupAdded(string) { c.count.Add(1) }
+
+// CreateGroup's explicit sync and the concurrent server notification can both
+// read an empty cache before either inserts. A successful server write must not
+// turn into a local UNIQUE error under this ordinary delivery order.
+func TestCompatConcurrentGroupSynchronizationKeepsOneCacheEntry(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		json.NewEncoder(w).Encode(map[string]any{"errCode": 0, "data": map[string]any{"groupInfos": []map[string]any{{"groupID": "fixture-group", "groupName": "Synthetic group", "ownerUserID": "alice", "groupType": 2}}}})
+	}))
+	defer server.Close()
+	ctx := ccontext.WithInfo(context.Background(), &ccontext.GlobalConfig{UserID: "alice", Token: "synthetic", IMConfig: sdk_struct.IMConfig{ApiAddr: server.URL, AllowInsecureLoopbackForTesting: true}})
+	store, err := db.NewDataBase(ctx, "alice", t.TempDir(), 1)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer store.Close(ctx)
+	cache := &concurrentGroupReads{DataBase: store}
+	cache.snapshots.Add(2)
+	manager := NewGroup("alice", cache, make(chan common.Cmd2Value, 8))
+	capture := &addedGroupCapture{}
+	manager.SetGroupListener(func() open_im_sdk_callback.OnGroupListener { return capture })
+	errors := make(chan error, 2)
+	for index := 0; index < 2; index++ {
+		go func() { errors <- manager.SyncGroups(ctx, "fixture-group") }()
+	}
+	for index := 0; index < 2; index++ {
+		if err := <-errors; err != nil {
+			t.Errorf("concurrent sync rejected successful server state: %v", err)
+		}
+	}
+	rows, err := store.GetGroups(ctx, []string{"fixture-group"})
+	if err != nil || len(rows) != 1 || rows[0].OwnerUserID != "alice" {
+		t.Fatal("group cache lost identity or duplicated state")
+	}
+}
+
+type concurrentMemberReads struct {
+	db_interface.DataBase
+	snapshots sync.WaitGroup
+}
+
+func (d *concurrentMemberReads) GetGroupSomeMemberInfo(ctx context.Context, id string, users []string) ([]*model_struct.LocalGroupMember, error) {
+	rows, err := d.DataBase.GetGroupSomeMemberInfo(ctx, id, users)
+	d.snapshots.Done()
+	d.snapshots.Wait()
+	return rows, err
+}
+func (c *addedGroupCapture) OnGroupMemberAdded(string) { c.count.Add(1) }
+func (c *addedGroupCapture) OnGroupInfoChanged(string) {}
+
+func TestCompatConcurrentGroupMemberSynchronizationKeepsOneIdentity(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		json.NewEncoder(w).Encode(map[string]any{"errCode": 0, "data": map[string]any{"members": []map[string]any{{"groupID": "fixture-group", "userID": "bob", "nickname": "Synthetic Bob", "roleLevel": 20}}}})
+	}))
+	defer server.Close()
+	ctx := ccontext.WithInfo(context.Background(), &ccontext.GlobalConfig{UserID: "alice", Token: "synthetic", IMConfig: sdk_struct.IMConfig{ApiAddr: server.URL, AllowInsecureLoopbackForTesting: true}})
+	store, err := db.NewDataBase(ctx, "alice", t.TempDir(), 1)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer store.Close(ctx)
+	if err := store.InsertGroup(ctx, &model_struct.LocalGroup{GroupID: "fixture-group", GroupType: 2, GroupName: "Synthetic group"}); err != nil {
+		t.Fatal(err)
+	}
+	cache := &concurrentMemberReads{DataBase: store}
+	cache.snapshots.Add(2)
+	manager := NewGroup("alice", cache, make(chan common.Cmd2Value, 8))
+	capture := &addedGroupCapture{}
+	manager.SetGroupListener(func() open_im_sdk_callback.OnGroupListener { return capture })
+	errors := make(chan error, 2)
+	for index := 0; index < 2; index++ {
+		go func() { errors <- manager.SyncGroupMembers(ctx, "fixture-group", "bob") }()
+	}
+	for index := 0; index < 2; index++ {
+		if err := <-errors; err != nil {
+			t.Errorf("concurrent member sync rejected existing identity: %v", err)
+		}
+	}
+	rows, err := store.GetGroupSomeMemberInfo(ctx, "fixture-group", []string{"bob"})
+	if err != nil || len(rows) != 1 || rows[0].UserID != "bob" {
+		t.Fatal("group member identity duplicated or lost")
+	}
+}
