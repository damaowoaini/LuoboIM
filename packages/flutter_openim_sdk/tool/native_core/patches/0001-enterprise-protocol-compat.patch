+package open_im_sdk
+
+import (
+	"context"
+	"encoding/json"
+	"github.com/OpenIMSDK/protocol/rtc"
+	"github.com/OpenIMSDK/protocol/sdkws"
+	"github.com/golang/protobuf/proto"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/ccontext"
+	"github.com/openimsdk/openim-sdk-core/v3/sdk_struct"
+	"net/http"
+	"net/http/httptest"
+	"sync"
+	"testing"
+	"time"
+)
+
+type compatCapture struct {
+	mu      sync.Mutex
+	events  map[string]int
+	timeout chan struct{}
+}
+
+func (c *compatCapture) add(name string)                       { c.mu.Lock(); c.events[name]++; c.mu.Unlock() }
+func (c *compatCapture) OnReceiveNewInvitation(string)         { c.add("invite") }
+func (c *compatCapture) OnInviteeAccepted(string)              { c.add("accept") }
+func (c *compatCapture) OnInviteeAcceptedByOtherDevice(string) { c.add("other-accept") }
+func (c *compatCapture) OnInviteeRejected(string)              { c.add("reject") }
+func (c *compatCapture) OnInviteeRejectedByOtherDevice(string) { c.add("other-reject") }
+func (c *compatCapture) OnInvitationCancelled(string)          { c.add("cancel") }
+func (c *compatCapture) OnInvitationTimeout(string) {
+	c.add("timeout")
+	if c.timeout != nil {
+		select {
+		case c.timeout <- struct{}{}:
+		default:
+		}
+	}
+}
+func (c *compatCapture) OnHangUp(string)                      { c.add("hangup") }
+func (c *compatCapture) OnRoomParticipantConnected(string)    { c.add("connected") }
+func (c *compatCapture) OnRoomParticipantDisconnected(string) { c.add("disconnected") }
+func (c *compatCapture) OnStreamChange(string)                { c.add("stream") }
+func (c *compatCapture) OnReceiveCustomSignal(string)         { c.add("custom") }
+func compatTestContext(base string) context.Context {
+	return ccontext.WithOperationID(ccontext.WithInfo(context.Background(), &ccontext.GlobalConfig{UserID: "alice", Token: "synthetic-token", IMConfig: sdk_struct.IMConfig{PlatformID: 2, ApiAddr: base, AllowInsecureLoopbackForTesting: true}}), "synthetic-operation")
+}
+func TestCompatProtobufEventsAndMultiDevice(t *testing.T) {
+	ctx, cancel := context.WithCancel(compatTestContext(""))
+	defer cancel()
+	capture := &compatCapture{events: make(map[string]int)}
+	u := &LoginMgr{ctx: ctx, signalingListener: capture}
+	defer u.clearCompatTimers()
+	inv := &rtc.InvitationInfo{InviterUserID: "bob", InviteeUserIDList: []string{"alice"}, RoomID: "room", Timeout: 30, InitiateTime: time.Now().Unix(), MediaType: "audio"}
+	messages := []proto.Message{&rtc.SignalReq{Payload: &rtc.SignalReq_Invite{Invite: &rtc.SignalInviteReq{UserID: "bob", Invitation: inv}}}, &rtc.SignalOnRoomParticipantConnectedReq{Invitation: inv}, &rtc.SignalOnRoomParticipantDisconnectedReq{Invitation: inv}, &rtc.SignalOnStreamChangeReq{RoomID: "room", StreamType: "audio", Mute: true}, &rtc.SignalSendCustomSignalReq{RoomID: "room", CustomInfo: "synthetic"}}
+	for index, message := range messages {
+		wire, _ := proto.Marshal(message)
+		u.dispatchCompatSignal(ctx, &sdkws.MsgData{ContentType: int32(1601 + index), Content: wire})
+	}
+	accepted := &rtc.SignalReq{Payload: &rtc.SignalReq_Accept{Accept: &rtc.SignalAcceptReq{UserID: "alice", OpUserPlatformID: 5, Invitation: inv}}}
+	wire, _ := proto.Marshal(accepted)
+	u.dispatchCompatSignal(ctx, &sdkws.MsgData{ContentType: 1601, Content: wire})
+	for _, event := range []string{"invite", "connected", "disconnected", "stream", "custom", "other-accept"} {
+		if capture.events[event] != 1 {
+			t.Fatalf("callback %s missing", event)
+		}
+	}
+	if capture.events["accept"] != 0 {
+		t.Fatal("other-device accepted delivered as local accept")
+	}
+	u.compatTimerMutex.Lock()
+	pending := len(u.compatPending)
+	u.compatTimerMutex.Unlock()
+	if pending != 0 {
+		t.Fatal("handled call timer remains")
+	}
+}
+func TestCompatTimeoutAndSessionCancellation(t *testing.T) {
+	ctx, cancel := context.WithCancel(compatTestContext(""))
+	capture := &compatCapture{events: make(map[string]int), timeout: make(chan struct{}, 2)}
+	u := &LoginMgr{ctx: ctx, signalingListener: capture}
+	defer u.clearCompatTimers()
+	u.trackCompatInvitation(ctx, compatSignalingInfo{Invitation: &rtc.InvitationInfo{RoomID: "expired", Timeout: 1, InitiateTime: time.Now().Add(-2 * time.Second).Unix()}})
+	select {
+	case <-capture.timeout:
+	case <-time.After(time.Second):
+		t.Fatal("timeout callback missing")
+	}
+	u.trackCompatInvitation(ctx, compatSignalingInfo{Invitation: &rtc.InvitationInfo{RoomID: "pending", Timeout: 60, InitiateTime: time.Now().Unix()}})
+	cancel()
+	deadline := time.Now().Add(time.Second)
+	for {
+		u.compatTimerMutex.Lock()
+		count := len(u.compatPending)
+		u.compatTimerMutex.Unlock()
+		if count == 0 {
+			break
+		}
+		if time.Now().After(deadline) {
+			t.Fatal("session timer leaked")
+		}
+		time.Sleep(time.Millisecond)
+	}
+	capture.mu.Lock()
+	count := capture.events["timeout"]
+	capture.mu.Unlock()
+	if count != 1 {
+		t.Fatal("cancelled session emitted timeout")
+	}
+}
+func TestCompatMeetingRequestsPreserveTargetAndBindActor(t *testing.T) {
+	var requests []map[string]any
+	var mu sync.Mutex
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		var body map[string]any
+		json.NewDecoder(r.Body).Decode(&body)
+		if r.Header.Get("token") != "synthetic-token" {
+			t.Error("missing authenticated token")
+		}
+		mu.Lock()
+		requests = append(requests, body)
+		mu.Unlock()
+		json.NewEncoder(w).Encode(map[string]any{"errCode": 0, "data": map[string]any{"ok": true}})
+	}))
+	defer server.Close()
+	ctx := compatTestContext(server.URL)
+	u := &LoginMgr{ctx: ctx}
+	for _, route := range []string{"/signal/signal_operate_stream", "/signal/signal_get_meetings", "/signal/get_signal_invitation_info_start_app", "/signal/signal_close_room", "/signal/signal_send_custom_signal", "/signal/signal_update_meeting_info", "/signal/signal_get_room_by_group_id"} {
+		_, err := u.compatSignalPost(ctx, route, `{"userID":"target","roomID":"room"}`)
+		if err != nil {
+			t.Fatal(err)
+		}
+	}
+	if requests[0]["userID"] != "target" {
+		t.Fatal("moderation target overwritten by actor")
+	}
+	if requests[1]["userID"] != "alice" || requests[2]["userID"] != "alice" {
+		t.Fatal("self request used untrusted actor")
+	}
+}
+
+func TestCompatOriginsRequireTLSAndExplicitLoopbackFixture(t *testing.T) {
+	for _, test := range []struct {
+		raw, scheme string
+		test, valid bool
+	}{{"https://im.example/api", "https", false, true}, {"wss://im.example/ws", "wss", false, true}, {"http://im.example", "https", true, false}, {"http://127.0.0.1:1", "https", false, false}, {"http://127.0.0.1:1", "https", true, true}, {"ws://10.0.2.2:1", "wss", true, true}, {"wss://user:pass@im.example", "wss", false, false}, {"https://im.example?token=x", "https", false, false}} {
+		if validCoreOrigin(test.raw, test.scheme, test.test) != test.valid {
+			t.Fatalf("origin policy mismatch: %s", test.raw)
+		}
+	}
+}
diff --git a/open_im_sdk/enterprise_rtc_notify.go b/open_im_sdk/enterprise_rtc_notify.go
new file mode 100644
index 0000000..3ab017d
--- /dev/null
+++ b/open_im_sdk/enterprise_rtc_notify.go
@@ -0,0 +1,112 @@
+package open_im_sdk
+
+import (
+	"context"
+	"encoding/json"
+	"github.com/OpenIMSDK/protocol/rtc"
+	"github.com/OpenIMSDK/protocol/sdkws"
+	"github.com/golang/protobuf/proto"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/ccontext"
+)
+
+func (u *LoginMgr) dispatchCompatSignal(ctx context.Context, message *sdkws.MsgData) {
+	if ctx.Err() != nil {
+		return
+	}
+	u.compatSignalMutex.RLock()
+	listener := u.signalingListener
+	u.compatSignalMutex.RUnlock()
+	if listener == nil {
+		return
+	}
+	switch message.ContentType {
+	case 1601:
+		var request rtc.SignalReq
+		if proto.Unmarshal(message.Content, &request) != nil {
+			return
+		}
+		actor := ""
+		var invitation *rtc.InvitationInfo
+		var push *sdkws.OfflinePushInfo
+		var action func(string)
+		actionName := ""
+		switch payload := request.Payload.(type) {
+		case *rtc.SignalReq_Invite:
+			actor = payload.Invite.UserID
+			invitation = payload.Invite.Invitation
+			push = payload.Invite.OfflinePushInfo
+			action = listener.OnReceiveNewInvitation
+			actionName = "invite"
+		case *rtc.SignalReq_InviteInGroup:
+			actor = payload.InviteInGroup.UserID
+			invitation = payload.InviteInGroup.Invitation
+			push = payload.InviteInGroup.OfflinePushInfo
+			action = listener.OnReceiveNewInvitation
+			actionName = "invite"
+		case *rtc.SignalReq_Accept:
+			actor = payload.Accept.UserID
+			invitation = payload.Accept.Invitation
+			push = payload.Accept.OfflinePushInfo
+			action = listener.OnInviteeAccepted
+			actionName = "accept"
+			if actor == ccontext.Info(ctx).UserID() && payload.Accept.OpUserPlatformID != ccontext.Info(ctx).PlatformID() {
+				action = listener.OnInviteeAcceptedByOtherDevice
+			}
+		case *rtc.SignalReq_Reject:
+			actor = payload.Reject.UserID
+			invitation = payload.Reject.Invitation
+			push = payload.Reject.OfflinePushInfo
+			action = listener.OnInviteeRejected
+			actionName = "reject"
+			if actor == ccontext.Info(ctx).UserID() && payload.Reject.OpUserPlatformID != ccontext.Info(ctx).PlatformID() {
+				action = listener.OnInviteeRejectedByOtherDevice
+			}
+		case *rtc.SignalReq_Cancel:
+			actor = payload.Cancel.UserID
+			invitation = payload.Cancel.Invitation
+			push = payload.Cancel.OfflinePushInfo
+			action = listener.OnInvitationCancelled
+			actionName = "cancel"
+		case *rtc.SignalReq_HungUp:
+			actor = payload.HungUp.UserID
+			invitation = payload.HungUp.Invitation
+			push = payload.HungUp.OfflinePushInfo
+			action = listener.OnHangUp
+			actionName = "hungUp"
+		}
+		if action != nil && invitation != nil {
+			info := compatSignalingInfo{UserID: actor, Invitation: invitation, OfflinePushInfo: push}
+			if actionName == "invite" {
+				u.trackCompatInvitation(ctx, info)
+			} else {
+				u.updateCompatInvitation(ctx, actionName, actor, invitation.RoomID)
+			}
+			encoded, _ := json.Marshal(info)
+			action(string(encoded))
+		}
+	case 1602:
+		var event rtc.SignalOnRoomParticipantConnectedReq
+		if proto.Unmarshal(message.Content, &event) != nil {
+			return
+		}
+		listener.OnRoomParticipantConnected(compatJSON(&event))
+	case 1603:
+		var event rtc.SignalOnRoomParticipantDisconnectedReq
+		if proto.Unmarshal(message.Content, &event) != nil {
+			return
+		}
+		listener.OnRoomParticipantDisconnected(compatJSON(&event))
+	case 1604:
+		var event rtc.SignalOnStreamChangeReq
+		if proto.Unmarshal(message.Content, &event) != nil {
+			return
+		}
+		listener.OnStreamChange(compatJSON(&event))
+	case 1605:
+		var event rtc.SignalSendCustomSignalReq
+		if proto.Unmarshal(message.Content, &event) != nil {
+			return
+		}
+		listener.OnReceiveCustomSignal(compatJSON(&event))
+	}
+}
diff --git a/open_im_sdk/enterprise_rtc_timers.go b/open_im_sdk/enterprise_rtc_timers.go
new file mode 100644
index 0000000..e53e27b
--- /dev/null
+++ b/open_im_sdk/enterprise_rtc_timers.go
@@ -0,0 +1,141 @@
+package open_im_sdk
+
+import (
+	"context"
+	"encoding/json"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/ccontext"
+	"time"
+)
+
+type compatPendingInvitation struct {
+	timer      *time.Timer
+	cancelStop func() bool
+	info       compatSignalingInfo
+	remaining  map[string]bool
+}
+
+func (u *LoginMgr) trackCompatInvitation(ctx context.Context, info compatSignalingInfo) {
+	if ctx.Err() != nil || info.Invitation == nil || info.Invitation.RoomID == "" {
+		return
+	}
+
+	invitation := *info.Invitation
+	invitation.InviteeUserIDList = append([]string(nil), info.Invitation.InviteeUserIDList...)
+	info.Invitation = &invitation
+	timeout := invitation.Timeout
+	if timeout <= 0 {
+		timeout = 30
+	}
+	if timeout > 120 {
+		timeout = 120
+	}
+	initiated := time.Unix(invitation.InitiateTime, 0)
+	if invitation.InitiateTime == 0 {
+		initiated = time.Now()
+	}
+	remaining := time.Until(initiated.Add(time.Duration(timeout) * time.Second))
+	if remaining < 0 {
+		remaining = 0
+	}
+	room := invitation.RoomID
+	u.compatTimerMutex.Lock()
+	defer u.compatTimerMutex.Unlock()
+	if ctx.Err() != nil {
+		return
+	}
+	if u.compatPending == nil {
+		u.compatPending = make(map[string]*compatPendingInvitation)
+	}
+	if _, exists := u.compatPending[room]; exists {
+		return
+	}
+	pending := &compatPendingInvitation{info: info, remaining: make(map[string]bool)}
+	for _, user := range invitation.InviteeUserIDList {
+		pending.remaining[user] = true
+	}
+	pending.timer = time.AfterFunc(remaining, func() {
+		u.compatTimerMutex.Lock()
+		if u.compatPending[room] != pending {
+			u.compatTimerMutex.Unlock()
+			return
+		}
+		delete(u.compatPending, room)
+		if pending.cancelStop != nil {
+			pending.cancelStop()
+		}
+		u.compatTimerMutex.Unlock()
+		if ctx.Err() != nil {
+			return
+		}
+		u.compatSignalMutex.RLock()
+		listener := u.signalingListener
+		u.compatSignalMutex.RUnlock()
+		if listener != nil {
+			encoded, _ := json.Marshal(info)
+			listener.OnInvitationTimeout(string(encoded))
+		}
+	})
+	u.compatPending[room] = pending
+	pending.cancelStop = context.AfterFunc(ctx, func() { u.stopCompatPending(room, pending) })
+}
+func (u *LoginMgr) stopCompatInvitation(room string) {
+	u.compatTimerMutex.Lock()
+	defer u.compatTimerMutex.Unlock()
+	if pending := u.compatPending[room]; pending != nil {
+		pending.timer.Stop()
+		if pending.cancelStop != nil {
+			pending.cancelStop()
+		}
+		delete(u.compatPending, room)
+	}
+}
+func (u *LoginMgr) updateCompatInvitation(ctx context.Context, action, actor, room string) {
+	if action == "cancel" || action == "hungUp" {
+		u.stopCompatInvitation(room)
+		return
+	}
+	self := ccontext.Info(ctx).UserID()
+	u.compatTimerMutex.Lock()
+	pending := u.compatPending[room]
+	stop := false
+	if pending != nil {
+		if actor == self || pending.info.Invitation.GroupID == "" {
+			stop = true
+		} else if pending.info.Invitation.InviterUserID == self {
+			if action == "accept" {
+				stop = true
+			} else if action == "reject" {
+				delete(pending.remaining, actor)
+				stop = len(pending.remaining) == 0
+			}
+		}
+		if stop {
+			pending.timer.Stop()
+			if pending.cancelStop != nil {
+				pending.cancelStop()
+			}
