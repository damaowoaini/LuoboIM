+func TestCompatEncryptionRefreshesLatestAndRejectsBadInbound(t *testing.T) {
+	const one = "0123456789abcdef0123456789abcdef"
+	const two = "abcdef0123456789abcdef0123456789"
+	var current atomic.Int32
+	current.Store(1)
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		var request struct {
+			ConversationID string `json:"conversationID"`
+			Version        int32  `json:"keyVersion"`
+		}
+		json.NewDecoder(r.Body).Decode(&request)
+		if request.ConversationID != "si_alice_bob" {
+			t.Error("wrong conversation key scope")
+		}
+		version := request.Version
+		if version == 0 {
+			version = current.Load()
+		}
+		var keys []map[string]any
+		if version == 1 {
+			keys = []map[string]any{{"version": 1, "key": one}}
+		} else if version == 2 {
+			keys = []map[string]any{{"version": 2, "key": two}}
+		}
+		json.NewEncoder(w).Encode(map[string]any{"errCode": 0, "data": map[string]any{"versionKeyList": keys}})
+	}))
+	defer server.Close()
+	ctx := ccontext.WithInfo(context.Background(), &ccontext.GlobalConfig{UserID: "alice", Token: "synthetic", IMConfig: sdk_struct.IMConfig{ApiAddr: server.URL, AllowInsecureLoopbackForTesting: true}})
+	core := &LongConnMgr{}
+	core.legacyEncryption.Store(true)
+	for version := int32(1); version <= 2; version++ {
+		current.Store(version)
+		message := &sdkws.MsgData{SendID: "alice", RecvID: "bob", ContentType: 101, Content: []byte(`{"content":"synthetic"}`)}
+		if err := core.encryptLegacyMessage(ctx, message); err != nil {
+			t.Fatal(err)
+		}
+		if message.KeyVersion != version {
+			t.Fatal("latest key pinned to old cached version")
+		}
+		key := one
+		if version == 2 {
+			key = two
+		}
+		plain, err := legacycipher.Decrypt(key, message.Content)
+		if err != nil || string(plain) != `{"content":"synthetic"}` {
+			t.Fatal("outgoing ciphertext mismatch")
+		}
+	}
+	encrypted, _ := legacycipher.Encrypt(one, []byte(`{"content":"historical"}`))
+	message := &sdkws.MsgData{SendID: "bob", RecvID: "alice", ContentType: 101, KeyVersion: 1, Content: encrypted}
+	core.legacyEncryption.Store(false)
+	if err := core.decryptLegacyMessages(ctx, map[string]*sdkws.PullMsgs{"si_alice_bob": {Msgs: []*sdkws.MsgData{message}}}); err != nil || string(message.Content) != `{"content":"historical"}` {
+		t.Fatal("historical encrypted message not decoded after server toggle")
+	}
+	// A bad item must not partially decrypt a batch, so later retry can use the
+	// original ciphertext for every message without double decoding the first.
+	first := &sdkws.MsgData{SendID: "bob", RecvID: "alice", KeyVersion: 1, Content: append([]byte(nil), encrypted...)}
+	bad := &sdkws.MsgData{SendID: "bob", RecvID: "alice", KeyVersion: 1, Content: []byte("bad")}
+	if err := core.decryptLegacyMessages(ctx, map[string]*sdkws.PullMsgs{"si_alice_bob": {Msgs: []*sdkws.MsgData{first, bad}}}); err == nil || !bytes.Equal(first.Content, encrypted) {
+		t.Fatal("failed batch mutated prior ciphertext")
+	}
+
+	for _, test := range []struct {
+		conversation string
+		version      int32
+		content      []byte
+	}{{"si_alice_bob", 1, []byte("corrupt")}, {"si_alice_bob", 9, encrypted}, {"si_wrong", 1, encrypted}} {
+		m := &sdkws.MsgData{SendID: "bob", RecvID: "alice", ContentType: 101, KeyVersion: test.version, Content: test.content}
+		if err := core.decryptLegacyMessages(ctx, map[string]*sdkws.PullMsgs{test.conversation: {Msgs: []*sdkws.MsgData{m}}}); err == nil {
+			t.Fatal("invalid ciphertext/key scope accepted")
+		}
+	}
+}
+
+func TestCompatNonEmptyMaxSeqResponseIsNotParsedAsMessagePull(t *testing.T) {
+	ctx := ccontext.WithInfo(context.Background(), &ccontext.GlobalConfig{UserID: "alice"})
+	core := &LongConnMgr{ctx: ctx, encoder: NewGobEncoder(), Syncer: NewWsRespAsyn()}
+	mid, ch := core.Syncer.AddCh("alice")
+	defer core.Syncer.DelCh(mid)
+	payload, _ := proto.Marshal(&sdkws.GetMaxSeqResp{MaxSeqs: map[string]int64{"n_service_alice": 12, "si_alice_bob": 7}, MinSeqs: map[string]int64{"si_alice_bob": 1}})
+	wire, _ := core.encoder.Encode(&GeneralWsResp{ReqIdentifier: constant.GetNewestSeq, MsgIncr: mid, Data: payload})
+	if err := core.handleMessage(wire); err != nil {
+		t.Fatal("synchronization response rejected", err)
+	}
+	select {
+	case response := <-ch:
+		if !bytes.Equal(response.Data, payload) {
+			t.Fatal("max sequence response was transformed")
+		}
+	case <-time.After(time.Second):
+		t.Fatal("max sequence waiter not notified")
+	}
+}
