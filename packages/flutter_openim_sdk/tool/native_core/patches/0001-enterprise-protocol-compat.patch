+package interaction
+
+import (
+	"context"
+	"github.com/OpenIMSDK/protocol/sdkws"
+	"testing"
+)
+
+func TestCompatNotificationConversationNamespaces(t *testing.T) {
+	for _, id := range []string{"n_service_alice"} {
+		if !IsNotification(id) {
+			t.Errorf("notification namespace not recognized: %s", id)
+		}
+	}
+	for _, id := range []string{"sn_service_alice", "si_alice_bob", "sg_group", "sn", "normal"} {
+		if IsNotification(id) {
+			t.Errorf("ordinary conversation misclassified: %s", id)
+		}
+	}
+}
+
+func TestCompatPushDoesNotMixConversationSequences(t *testing.T) {
+	defer func() {
+		if recover() != nil {
+			t.Fatal("contiguous independent conversations unexpectedly required network synchronization")
+		}
+	}()
+	syncer := &MsgSyncer{syncedMaxSeqs: make(map[string]int64)}
+	a := &sdkws.MsgData{ClientMsgID: "message-a", Seq: 1}
+	b := &sdkws.MsgData{ClientMsgID: "message-b", Seq: 1}
+	expected := map[string]*sdkws.MsgData{"si_alice_bob": a, "sg_group": b}
+	received := make(map[string]bool)
+	syncer.pushTriggerAndSync(context.Background(), map[string]*sdkws.PullMsgs{
+		"si_alice_bob": {Msgs: []*sdkws.MsgData{a}}, "sg_group": {Msgs: []*sdkws.MsgData{b}},
+	}, func(_ context.Context, batch map[string]*sdkws.PullMsgs) error {
+		for id, msgs := range batch {
+			if len(msgs.Msgs) != 1 || msgs.Msgs[0] != expected[id] {
+				t.Fatal("messages crossed conversation boundary")
+			}
+			received[id] = true
+		}
+		return nil
+	})
+	if len(received) != 2 || syncer.syncedMaxSeqs["si_alice_bob"] != 1 || syncer.syncedMaxSeqs["sg_group"] != 1 {
+		t.Fatal("independent contiguous messages were dropped")
+	}
+}
