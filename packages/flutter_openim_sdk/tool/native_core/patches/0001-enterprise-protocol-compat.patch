diff --git a/pkg/privateexpiry/expiry.go b/pkg/privateexpiry/expiry.go
new file mode 100644
index 0000000..0510e94
--- /dev/null
+++ b/pkg/privateexpiry/expiry.go
@@ -0,0 +1,33 @@
+// Copyright 2026 LuoboIM contributors. Licensed under Apache-2.0.
+package privateexpiry
+
+// Deadline uses an observed read timestamp, never send time or IsRead alone.
+// Millisecond dates are unchanged. Historical Unix-second values are accepted
+// only within the explicit modern-date window2000-01-01 through2100-01-01.
+// Missing/zero duration preserves the original Flutter client's30s default.
+// A negative timestamp/duration or overflowing deadline is unknown, not expired.
+func Deadline(readAt, durationSeconds int64) (int64, bool) {
+	if readAt <= 0 || durationSeconds < 0 {
+		return 0, false
+	}
+	if readAt >= 946684800 && readAt <= 4102444800 {
+		readAt *= 1000
+	}
+	if durationSeconds == 0 {
+		durationSeconds = 30
+	}
+	// Match the mobile DateTime range, also guarding multiplication/addition.
+	const maxTimestamp int64 = 8640000000000000
+	if readAt > maxTimestamp || durationSeconds > (maxTimestamp-readAt)/1000 {
+		return 0, false
+	}
+	return readAt + durationSeconds*1000, true
+}
+
+func Expired(isPrivate bool, readAt, durationSeconds, nowMillis int64) bool {
+	if !isPrivate {
+		return false
+	}
+	deadline, known := Deadline(readAt, durationSeconds)
+	return known && nowMillis >= deadline
+}
diff --git a/pkg/privateexpiry/expiry_test.go b/pkg/privateexpiry/expiry_test.go
new file mode 100644
index 0000000..f6fe989
--- /dev/null
+++ b/pkg/privateexpiry/expiry_test.go
@@ -0,0 +1,57 @@
+package privateexpiry
+
+import (
+	"math"
+	"testing"
+)
+
+func TestDeadlineCompatibilityAndInvalidMetadata(t *testing.T) {
+	for _, tc := range []struct {
+		name                     string
+		read, duration, expected int64
+		known                    bool
+	}{
+		{"milliseconds", 1700000000123, 30, 1700000030123, true},
+		{"zero_duration_legacy_default", 1700000000123, 0, 1700000030123, true},
+		{"seconds_lower_inclusive", 946684800, 5, 946684805000, true},
+		{"seconds_upper_inclusive", 4102444800, 5, 4102444805000, true},
+		{"below_seconds_window_unchanged_ms", 946684799, 5, 946689799, true},
+		{"above_seconds_window_unchanged_ms", 4102444801, 5, 4102449801, true},
+		{"unread", 0, 30, 0, false},
+		{"negative_read", -1, 30, 0, false},
+		{"negative_duration", 1700000000123, -1, 0, false},
+		{"invalid_read_overflow", math.MaxInt64, 30, 0, false},
+		{"duration_overflow", 1700000000123, math.MaxInt64, 0, false},
+		{"deadline_overflow", 8640000000000000, 30, 0, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			at, known := Deadline(tc.read, tc.duration)
+			if at != tc.expected || known != tc.known {
+				t.Fatalf("deadline=(%d,%t), want(%d,%t)", at, known, tc.expected, tc.known)
+			}
+		})
+	}
+}
+
+func TestExpiredUsesReadTimeAndExactBoundaryOnly(t *testing.T) {
+	const read int64 = 1700000000123
+	for _, tc := range []struct {
+		name      string
+		private   bool
+		read, now int64
+		want      bool
+	}{
+		{"before", true, read, read + 29999, false},
+		{"exact", true, read, read + 30000, true},
+		{"after", true, read, read + 30001, true},
+		{"ordinary_encrypted_chat", false, read, read + 30001, false},
+		{"unread_even_if_sent_long_ago", true, 0, read + 30001, false},
+		{"future_observed_read", true, read + 60000, read, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			if actual := Expired(tc.private, tc.read, 30, tc.now); actual != tc.want {
+				t.Fatalf("Expired=%t, want%t", actual, tc.want)
+			}
+		})
+	}
+}
