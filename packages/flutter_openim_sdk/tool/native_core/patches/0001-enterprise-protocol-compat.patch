@@ -0,0 +1,31 @@
+// Copyright 2026 LuoboIM contributors.
+// SPDX-License-Identifier: Apache-2.0
+
+package conversation_msg
+
+import (
+	"context"
+
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/sdkerrs"
+)
+
+// Continue attempting the remaining local conversations and publish confirmed
+// successes even after a failure. The fixed error must not contain a database
+// error, conversation identifier, or message content. This is a partial-result
+// error: a server clear may already have committed and cannot be rolled back.
+func clearLocalConversationBatch(ctx context.Context, ids []string, clear func(context.Context, string) error, notify func([]string)) error {
+	successes := make([]string, 0, len(ids))
+	failed := false
+	for _, id := range ids {
+		if err := clear(ctx, id); err != nil {
+			failed = true
+			continue
+		}
+		successes = append(successes, id)
+	}
+	notify(successes)
+	if failed {
+		return sdkerrs.New(sdkerrs.SdkInternalError, "local message clear incomplete", "")
+	}
+	return nil
+}
