+package diagnostics
+
+import (
+	"context"
+	"errors"
+	"gorm.io/gorm/logger"
+	"testing"
+	"time"
+)
+
+// A strict SQL logger must not even evaluate the closure, which can contain a
+// message body and may execute expensive formatting even when output is hidden.
+func TestSQLContentNeverEvaluatedAtAnyLogLevel(t *testing.T) {
+	for _, level := range []logger.LogLevel{logger.Silent, logger.Error, logger.Warn, logger.Info} {
+		log := NewSqlLogger(level, false, 0).LogMode(level)
+		log.Trace(context.Background(), time.Now(), func() (string, int64) { t.Fatal("SQL content evaluated"); return "private", 1 }, errors.New("private"))
+	}
+}
