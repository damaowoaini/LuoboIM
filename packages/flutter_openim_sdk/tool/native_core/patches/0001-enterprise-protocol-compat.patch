index 0000000..c0928e6
--- /dev/null
+++ b/internal/conversation_msg/enterprise_group_read.go
@@ -0,0 +1,156 @@
+package conversation_msg
+
+import (
+	"context"
+	"encoding/json"
+	groupPb "github.com/OpenIMSDK/protocol/group"
+	msgPb "github.com/OpenIMSDK/protocol/msg"
+	"github.com/OpenIMSDK/protocol/sdkws"
+	"github.com/openimsdk/openim-sdk-core/v3/internal/util"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/ccontext"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/sdkerrs"
+	"strings"
+)
+
+func (c *Conversation) CompatGroupReaders(ctx context.Context, conversation, id string, filter, offset, count int) ([]map[string]any, error) {
+	if !strings.HasPrefix(conversation, "sg_") || id == "" || filter < 0 || filter > 1 || offset < 0 || offset > 100000 || count < 1 || count > 100 {
+		return nil, sdkerrs.ErrArgs
+	}
+	stored, err := c.db.GetConversation(ctx, conversation)
+	if err != nil || stored.GroupID == "" {
+		return nil, sdkerrs.ErrArgs
+	}
+	// Runtime constants are 0=read,1=unread; old proto comments were reversed.
+	request := &msgPb.GetGroupMessageHasReadReq{ConversationID: conversation, ClientMsgID: id, Type: int32(filter), Pagination: &sdkws.RequestPagination{PageNumber: int32(offset/count + 1), ShowNumber: int32(count)}}
+	response, err := util.CallApi[msgPb.GetGroupMessageHasReadResp](ctx, "/msg/get_group_message_has_read", request)
+	if err != nil {
+		return nil, err
+	}
+	reads := response.Reads
+	skip := offset % count
+	if skip > 0 && len(reads) > skip {
+		request.Pagination.PageNumber++
+		next, err := util.CallApi[msgPb.GetGroupMessageHasReadResp](ctx, "/msg/get_group_message_has_read", request)
+		if err != nil {
+			return nil, err
+		}
+		reads = append(reads, next.Reads...)
+	}
+	if skip >= len(reads) {
+		return []map[string]any{}, nil
+	}
+	reads = reads[skip:]
+	if len(reads) > count {
+		reads = reads[:count]
+	}
+	ids := make([]string, 0, len(reads))
+	for _, read := range reads {
+		ids = append(ids, read.UserID)
+	}
+	if len(ids) == 0 {
+		return []map[string]any{}, nil
+	}
+	members, err := util.CallApi[groupPb.GetGroupMembersInfoResp](ctx, "/group/get_group_members_info", &groupPb.GetGroupMembersInfoReq{GroupID: stored.GroupID, UserIDs: ids})
+	if err != nil {
+		return nil, err
+	}
+	mapped := make(map[string]*sdkws.GroupMemberFullInfo)
+	for _, member := range members.Members {
+		mapped[member.UserID] = member
+	}
+	result := make([]map[string]any, 0, len(reads))
+	for _, read := range reads {
+		value := map[string]any{"userID": read.UserID, "groupID": stored.GroupID, "readTime": read.ReadTime}
+		if member := mapped[read.UserID]; member != nil {
+			data, _ := json.Marshal(member)
+			json.Unmarshal(data, &value)
+			value["readTime"] = read.ReadTime
+		}
+		result = append(result, value)
+	}
+	return result, nil
+}
+func (c *Conversation) CompatMarkGroupRead(ctx context.Context, conversation string, ids []string) (*msgPb.MarkGroupMessageReadResp, error) {
+	if !strings.HasPrefix(conversation, "sg_") || len(ids) == 0 || len(ids) > 1000 {
+		return nil, sdkerrs.ErrArgs
+	}
+	senders := make(map[string]string, len(ids))
+	for _, id := range ids {
+		if ctx.Err() != nil {
+			return nil, sdkerrs.ErrCtxDeadline
+		}
+		message, err := c.db.GetMessage(ctx, conversation, id)
+		if err != nil {
+			return nil, err
+		}
+		senders[id] = message.SendID
+	}
+	return util.CallApi[msgPb.MarkGroupMessageReadResp](ctx, "/msg/mark_group_message_read", &msgPb.MarkGroupMessageReadReq{UserID: ccontext.Info(ctx).UserID(), ConversationID: conversation, ClientMsgs: senders})
+}
+func (c *Conversation) handleCompatGroupReceipt(ctx context.Context, message *sdkws.MsgData) {
+	var envelope struct {
+		Detail string `json:"detail"`
+	}
+	data := message.Content
+	if json.Unmarshal(data, &envelope) == nil && envelope.Detail != "" {
+		data = []byte(envelope.Detail)
+	}
+	var tips sdkws.GroupMsgReadTips
+	if json.Unmarshal(data, &tips) != nil {
+		return
+	}
+	events := make([]map[string]any, 0, len(tips.Reads))
+	for _, read := range tips.Reads {
+		if read == nil || !strings.HasPrefix(read.ConversationID, "sg_") || read.ClientMsgID == "" {
+			continue
+		}
+		users := make([]map[string]any, 0, len(read.Users))
+		ids := []string{}
+		for _, user := range read.Users {
+			if user != nil {
+				users = append(users, map[string]any{"userID": user.UserID, "readTime": user.ReadTime})
+				ids = append(ids, user.UserID)
+			}
+		}
+		if stored, err := c.db.GetMessage(ctx, read.ConversationID, read.ClientMsgID); err == nil {
+			attached := make(map[string]any)
+			json.Unmarshal([]byte(stored.AttachedInfo), &attached)
+			if attached == nil {
+				attached = make(map[string]any)
+			}
+			group, _ := attached["groupHasReadInfo"].(map[string]any)
+			if group == nil {
+				group = make(map[string]any)
+			}
+			existing := make(map[string]bool)
+			if previous, ok := group["hasReadUserIDList"].([]any); ok {
+				for _, id := range previous {
+					if text, ok := id.(string); ok {
+						existing[text] = true
+					}
+				}
+			}
+			for _, id := range ids {
+				existing[id] = true
+			}
+			combined := make([]string, 0, len(existing))
+			for id := range existing {
+				combined = append(combined, id)
+			}
+			group["hasReadUserIDList"] = combined
+			group["hasReadCount"] = read.ReadNum
+			group["unreadCount"] = read.UnreadNum
+			attached["groupHasReadInfo"] = group
+			encoded, _ := json.Marshal(attached)
+			stored.AttachedInfo = string(encoded)
+			if ctx.Err() == nil {
+				_ = c.db.UpdateMessage(ctx, read.ConversationID, stored)
+			}
+		}
+		events = append(events, map[string]any{"clientMsgID": read.ClientMsgID, "hasReadCount": read.ReadNum, "unreadCount": read.UnreadNum, "readMembers": users})
+	}
+	if len(events) > 0 && ctx.Err() == nil {
+		encoded, _ := json.Marshal(events)
+		c.msgListener().OnRecvGroupReadReceipt(string(encoded))
+	}
+}
