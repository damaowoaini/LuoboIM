+
+type compatSignalingInfo struct {
+	UserID          string                 `json:"userID"`
+	Invitation      *rtc.InvitationInfo    `json:"invitation"`
+	OfflinePushInfo *sdkws.OfflinePushInfo `json:"offlinePushInfo"`
+}
+
+func SetSignalingListener(listener open_im_sdk_callback.OnSignalingListener) {
+	listenerCall(UserForSDK.SetCompatSignalingListener, listener)
+}
+func (u *LoginMgr) SetCompatSignalingListener(listener open_im_sdk_callback.OnSignalingListener) {
+	u.compatSignalMutex.Lock()
+	u.signalingListener = listener
+	u.compatSignalMutex.Unlock()
+}
+func SetSelfInfoEx(callback open_im_sdk_callback.Base, operationID, userInfo string) {
+	SetSelfInfo(callback, operationID, userInfo)
+}
+func SignalingInvite(callback open_im_sdk_callback.Base, operationID, info string) {
+	call(callback, operationID, UserForSDK.compatSignal, "invite", info)
+}
+func SignalingInviteInGroup(callback open_im_sdk_callback.Base, operationID, info string) {
+	call(callback, operationID, UserForSDK.compatSignal, "inviteInGroup", info)
+}
+func SignalingAccept(callback open_im_sdk_callback.Base, operationID, info string) {
