+}
+func SignalingReject(callback open_im_sdk_callback.Base, operationID, info string) {
+	call(callback, operationID, UserForSDK.compatSignal, "reject", info)
+}
+func SignalingCancel(callback open_im_sdk_callback.Base, operationID, info string) {
+	call(callback, operationID, UserForSDK.compatSignal, "cancel", info)
+}
+func SignalingHungUp(callback open_im_sdk_callback.Base, operationID, info string) {
+	call(callback, operationID, UserForSDK.compatSignal, "hungUp", info)
+}
+func SignalingGetTokenByRoomID(callback open_im_sdk_callback.Base, operationID, room string) {
+	call(callback, operationID, UserForSDK.compatSignal, "getTokenByRoomID", room)
+}
+func (u *LoginMgr) compatSignal(ctx context.Context, kind, input string) (any, error) {
+	if ctx.Err() != nil {
+		return nil, sdkerrs.ErrCtxDeadline
+	}
+	var info compatSignalingInfo
+	if kind != "getTokenByRoomID" {
+		if json.Unmarshal([]byte(input), &info) != nil || info.Invitation == nil {
+			return nil, sdkerrs.ErrArgs
+		}
+	}
+	if info.Invitation != nil && (kind == "invite" || kind == "inviteInGroup") {
+		info.Invitation.InviterUserID = ccontext.Info(ctx).UserID()
+		info.Invitation.PlatformID = ccontext.Info(ctx).PlatformID()
+		if info.Invitation.Timeout <= 0 {
+			info.Invitation.Timeout = 30
+		}
+		if info.Invitation.InitiateTime == 0 {
+			info.Invitation.InitiateTime = time.Now().Unix()
+		}
+	}
+	actor := ccontext.Info(ctx).UserID()
+	platform := ccontext.Info(ctx).PlatformID()
+	participant := &rtc.ParticipantMetaData{UserInfo: &sdkws.PublicUserInfo{UserID: actor}}
+	if u.User() != nil {
+		if self, err := u.User().GetSelfUserInfo(ctx); err == nil {
+			participant.UserInfo.Nickname = self.Nickname
+			participant.UserInfo.FaceURL = self.FaceURL
+		}
+	}
+	var request rtc.SignalReq
+	switch kind {
+	case "invite":
+		request.Payload = &rtc.SignalReq_Invite{Invite: &rtc.SignalInviteReq{Invitation: info.Invitation, OfflinePushInfo: info.OfflinePushInfo, Participant: participant, UserID: actor}}
+	case "inviteInGroup":
+		request.Payload = &rtc.SignalReq_InviteInGroup{InviteInGroup: &rtc.SignalInviteInGroupReq{Invitation: info.Invitation, OfflinePushInfo: info.OfflinePushInfo, Participant: participant, UserID: actor}}
+	case "accept":
+		request.Payload = &rtc.SignalReq_Accept{Accept: &rtc.SignalAcceptReq{Invitation: info.Invitation, OfflinePushInfo: info.OfflinePushInfo, UserID: actor, OpUserPlatformID: platform, Participant: participant}}
+	case "reject":
+		request.Payload = &rtc.SignalReq_Reject{Reject: &rtc.SignalRejectReq{Invitation: info.Invitation, OfflinePushInfo: info.OfflinePushInfo, UserID: actor, OpUserPlatformID: platform, Participant: participant}}
+	case "cancel":
+		request.Payload = &rtc.SignalReq_Cancel{Cancel: &rtc.SignalCancelReq{Invitation: info.Invitation, OfflinePushInfo: info.OfflinePushInfo, Participant: participant, UserID: actor}}
+	case "hungUp":
+		request.Payload = &rtc.SignalReq_HungUp{HungUp: &rtc.SignalHungUpReq{Invitation: info.Invitation, OfflinePushInfo: info.OfflinePushInfo, UserID: actor}}
+	case "getTokenByRoomID":
+		request.Payload = &rtc.SignalReq_GetTokenByRoomID{GetTokenByRoomID: &rtc.SignalGetTokenByRoomIDReq{RoomID: input, UserID: actor}}
+	default:
+		return nil, sdkerrs.ErrArgs
+	}
+	// Current gateway serializes the RPC assembly wrapper. Original Enterprise
+	// JNI succeeds against this exact wire contract; do not flatten the server.
+	var assembled rtc.SignalMessageAssembleResp
+	if err := u.longConnMgr.SendReqWaitResp(ctx, &request, constant.SendSignalMsg, &assembled); err != nil {
+		return nil, err
+	}
+	if ctx.Err() != nil {
+		return nil, sdkerrs.ErrCtxDeadline
+	}
+	response := assembled.SignalResp
+	if response == nil {
+		return nil, sdkerrs.ErrArgs.Wrap("missing signaling response")
+	}
+	if kind == "invite" && response.GetInvite() != nil {
+		info.Invitation.RoomID = response.GetInvite().RoomID
+		u.trackCompatInvitation(ctx, info)
+	}
+	if kind == "inviteInGroup" && response.GetInviteInGroup() != nil {
+		info.Invitation.RoomID = response.GetInviteInGroup().RoomID
+		u.trackCompatInvitation(ctx, info)
+	}
+	if info.Invitation != nil && (kind == "accept" || kind == "reject" || kind == "cancel" || kind == "hungUp") {
+		u.updateCompatInvitation(ctx, kind, actor, info.Invitation.RoomID)
+	}
+	switch kind {
+	case "invite":
+		if response.GetInvite() == nil {
+			return nil, sdkerrs.ErrArgs
+		}
+		return response.GetInvite(), nil
+	case "inviteInGroup":
+		if response.GetInviteInGroup() == nil {
+			return nil, sdkerrs.ErrArgs
+		}
+		return response.GetInviteInGroup(), nil
+	case "accept":
+		if response.GetAccept() == nil {
+			return nil, sdkerrs.ErrArgs
+		}
+		return response.GetAccept(), nil
+	case "getTokenByRoomID":
+		if response.GetGetTokenByRoomID() == nil {
+			return nil, sdkerrs.ErrArgs
+		}
+		return response.GetGetTokenByRoomID(), nil
+	default:
+		return map[string]any{}, nil
+	}
+}
+func (u *LoginMgr) compatSignalPost(ctx context.Context, route, input string) (json.RawMessage, error) {
+	if len(input) > 1<<20 {
+		return nil, sdkerrs.ErrArgs
+	}
+	request := make(map[string]any)
+	if input != "" && json.Unmarshal([]byte(input), &request) != nil {
+		return nil, sdkerrs.ErrArgs
+	}
+	switch route {
+	case "/signal/signal_get_meetings", "/signal/get_signal_invitation_info_start_app", "/signal/signal_join_meeting":
+		request["userID"] = ccontext.Info(ctx).UserID()
+	}
+	if route == "/signal/signal_create_meeting" && (request["meetingHostUserID"] == nil || request["meetingHostUserID"] == "") {
+		request["meetingHostUserID"] = ccontext.Info(ctx).UserID()
+	}
+	if route == "/signal/signal_join_meeting" || route == "/signal/signal_create_meeting" {
+		user := map[string]any{"userID": ccontext.Info(ctx).UserID()}
+		if u.User() != nil {
+			if self, err := u.User().GetSelfUserInfo(ctx); err == nil {
+				user["nickname"] = self.Nickname
+				user["faceURL"] = self.FaceURL
+			}
+		}
+		if nickname, ok := request["participantNickname"].(string); ok && nickname != "" {
+			user["nickname"] = nickname
+		}
+		request["participant"] = map[string]any{"userInfo": user}
+	}
+	var response json.RawMessage
+	if err := util.ApiPost(ctx, route, request, &response); err != nil {
+		return nil, err
+	}
+	if len(response) == 0 {
+		response = []byte(`{}`)
+	}
+	return response, nil
+}
+func SignalingGetRoomByGroupID(callback open_im_sdk_callback.Base, operationID, group string) {
+	call(callback, operationID, UserForSDK.compatSignalPost, "/signal/signal_get_room_by_group_id", compatJSON(map[string]any{"groupID": group}))
+}
+func GetSignalingInvitationInfoStartApp(callback open_im_sdk_callback.Base, operationID string) {
+	call(callback, operationID, UserForSDK.compatSignalPost, "/signal/get_signal_invitation_info_start_app", "")
+}
+func SignalingCreateMeeting(callback open_im_sdk_callback.Base, operationID, info string) {
+	call(callback, operationID, UserForSDK.compatSignalPost, "/signal/signal_create_meeting", info)
+}
+func SignalingJoinMeeting(callback open_im_sdk_callback.Base, operationID, info string) {
+	call(callback, operationID, UserForSDK.compatSignalPost, "/signal/signal_join_meeting", info)
+}
+func SignalingUpdateMeetingInfo(callback open_im_sdk_callback.Base, operationID, info string) {
+	call(callback, operationID, UserForSDK.compatSignalPost, "/signal/signal_update_meeting_info", info)
+}
+func SignalingGetMeetings(callback open_im_sdk_callback.Base, operationID string) {
+	call(callback, operationID, UserForSDK.compatSignalPost, "/signal/signal_get_meetings", "")
+}
+func SignalingCloseRoom(callback open_im_sdk_callback.Base, operationID, room string) {
+	call(callback, operationID, UserForSDK.compatSignalPost, "/signal/signal_close_room", compatJSON(map[string]any{"roomID": room}))
+}
+func SignalingOperateStream(callback open_im_sdk_callback.Base, operationID, stream, room, user string, mute, muteAll bool) {
+	call(callback, operationID, UserForSDK.compatSignalPost, "/signal/signal_operate_stream", compatJSON(map[string]any{"streamType": stream, "roomID": room, "userID": user, "mute": mute, "muteAll": muteAll}))
+}
+func SignalingSendCustomSignal(callback open_im_sdk_callback.Base, operationID, custom, room string) {
+	call(callback, operationID, UserForSDK.compatSignalPost, "/signal/signal_send_custom_signal", compatJSON(map[string]any{"customInfo": custom, "roomID": room}))
+}
+func compatJSON(value any) string { data, _ := json.Marshal(value); return string(data) }
