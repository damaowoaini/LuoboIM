diff --git a/internal/legacycipher/legacy.go b/internal/legacycipher/legacy.go
new file mode 100644
index 0000000..2480c2e
--- /dev/null
+++ b/internal/legacycipher/legacy.go
@@ -0,0 +1,66 @@
+// Package legacycipher implements only the existing OpenIM Enterprise wire
+// cipher verified against synthetic native captures. It must never be chosen
+// as a new general-purpose encryption protocol: deterministic IV and absent
+// authentication are inherited compatibility constraints. A negotiated new
+// protocol must use random nonces and authenticated encryption.
+package legacycipher
+
+import (
+	"crypto/aes"
+	"crypto/cipher"
+	"crypto/subtle"
+	"errors"
+)
+
+var ErrInvalidCiphertext = errors.New("invalid legacy ciphertext")
+var ErrInvalidKey = errors.New("invalid legacy key")
+
+// Encrypt preserves the old raw-32-byte-key, IV=key[:16], PKCS7 wire format.
+// Version selection and authorization belong to the account-bound key provider.
+func Encrypt(key string, plaintext []byte) ([]byte, error) {
+	if len(key) != 32 {
+		return nil, ErrInvalidKey
+	}
+	block, err := aes.NewCipher([]byte(key))
+	if err != nil {
+		return nil, ErrInvalidKey
+	}
+	padding := aes.BlockSize - len(plaintext)%aes.BlockSize
+	input := make([]byte, len(plaintext)+padding)
+	copy(input, plaintext)
+	for index := len(plaintext); index < len(input); index++ {
+		input[index] = byte(padding)
+	}
+	output := make([]byte, len(input))
+	cipher.NewCBCEncrypter(block, []byte(key)[:aes.BlockSize]).CryptBlocks(output, input)
+	return output, nil
+}
+
+// Decrypt checks block length and all padding bytes before returning plaintext.
+// Valid padding cannot authenticate CBC content. Callers must additionally
+// validate the expected message schema and never expose a padding oracle.
+func Decrypt(key string, ciphertext []byte) ([]byte, error) {
+	if len(key) != 32 {
+		return nil, ErrInvalidKey
+	}
+	if len(ciphertext) == 0 || len(ciphertext)%aes.BlockSize != 0 {
+		return nil, ErrInvalidCiphertext
+	}
+	block, err := aes.NewCipher([]byte(key))
+	if err != nil {
+		return nil, ErrInvalidKey
+	}
+	output := make([]byte, len(ciphertext))
+	cipher.NewCBCDecrypter(block, []byte(key)[:aes.BlockSize]).CryptBlocks(output, ciphertext)
+	padding := int(output[len(output)-1])
+	valid := subtle.ConstantTimeLessOrEq(1, padding) & subtle.ConstantTimeLessOrEq(padding, aes.BlockSize)
+	for index := 0; index < aes.BlockSize; index++ {
+		within := subtle.ConstantTimeLessOrEq(index+1, padding)
+		match := subtle.ConstantTimeByteEq(output[len(output)-1-index], byte(padding))
+		valid &= subtle.ConstantTimeSelect(within, match, 1)
+	}
+	if valid != 1 {
+		return nil, ErrInvalidCiphertext
+	}
+	return output[:len(output)-padding], nil
+}
diff --git a/internal/legacycipher/legacy_test.go b/internal/legacycipher/legacy_test.go
new file mode 100644
index 0000000..6afb7e2
--- /dev/null
+++ b/internal/legacycipher/legacy_test.go
@@ -0,0 +1,86 @@
+package legacycipher
+
+import (
+	"bytes"
+	"crypto/aes"
+	"crypto/cipher"
+	"encoding/base64"
+	"encoding/json"
+	"errors"
+	"os"
+	"testing"
+)
+
+func TestActualNativeCapturesBothKeyVersions(t *testing.T) {
+	data, err := os.ReadFile("testdata/native_vectors.json")
+	if err != nil {
+		t.Fatal(err)
+	}
+	var fixture struct {
+		Captures []struct {
+			Key     string `json:"key"`
+			Content string `json:"contentBase64"`
+		} `json:"captures"`
+		Plaintext []string `json:"plaintextUtf8"`
+	}
+	if err := json.Unmarshal(data, &fixture); err != nil {
+		t.Fatal(err)
+	}
+	if len(fixture.Captures) != 3 {
+		t.Fatal("expected native captures")
+	}
+	for index, capture := range fixture.Captures {
+		ciphertext, err := base64.StdEncoding.DecodeString(capture.Content)
+		if err != nil {
+			t.Fatal(err)
+		}
+		plain, err := Decrypt(capture.Key, ciphertext)
+		if err != nil || string(plain) != fixture.Plaintext[index] {
+			t.Fatalf("native capture %d decryption mismatch", index)
+		}
+		encoded, err := Encrypt(capture.Key, []byte(fixture.Plaintext[index]))
+		if err != nil || !bytes.Equal(encoded, ciphertext) {
+			t.Fatalf("native capture %d encryption mismatch", index)
+		}
+	}
+}
+
+func TestRejectsMalformedLengthAndEveryInvalidPaddingByte(t *testing.T) {
+	key := "0123456789abcdef0123456789abcdef"
+	for _, value := range [][]byte{nil, {}, {1}, make([]byte, 31)} {
+		if _, err := Decrypt(key, value); !errors.Is(err, ErrInvalidCiphertext) {
+			t.Fatal("malformed block accepted")
+		}
+	}
+	block, _ := aes.NewCipher([]byte(key))
+	for padding := 1; padding <= aes.BlockSize; padding++ {
+		for invalidIndex := 0; invalidIndex < padding; invalidIndex++ {
+			plain := bytes.Repeat([]byte{byte(padding)}, aes.BlockSize)
+			plain[len(plain)-1-invalidIndex] = 0
+			encoded := make([]byte, len(plain))
+			cipher.NewCBCEncrypter(block, []byte(key)[:aes.BlockSize]).CryptBlocks(encoded, plain)
+			if _, err := Decrypt(key, encoded); !errors.Is(err, ErrInvalidCiphertext) {
+				t.Fatal("corrupt padding accepted")
+			}
+		}
+	}
+}
+
+func TestDoesNotModifyCallerBuffersAndChecksKeySize(t *testing.T) {
+	key := "0123456789abcdef0123456789abcdef"
+	plain := []byte("fixture")
+	encoded, _ := Encrypt(key, plain)
+	before := append([]byte(nil), encoded...)
+	if _, err := Decrypt(key, encoded); err != nil {
+		t.Fatal(err)
+	}
+	if string(plain) != "fixture" || !bytes.Equal(before, encoded) {
+		t.Fatal("caller buffer modified")
+	}
+	if _, err := Encrypt("short", plain); !errors.Is(err, ErrInvalidKey) {
+		t.Fatal("bad key accepted")
+	}
+	if _, err := Decrypt("short", encoded); !errors.Is(err, ErrInvalidKey) {
+		t.Fatal("bad key accepted")
+	}
+}
