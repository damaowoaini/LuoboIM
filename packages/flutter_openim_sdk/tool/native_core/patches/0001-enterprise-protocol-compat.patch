@@ -0,0 +1,124 @@
+package interaction
+
+import (
+	"context"
+	"encoding/json"
+	"github.com/OpenIMSDK/protocol/encryption"
+	"github.com/OpenIMSDK/protocol/sdkws"
+	"github.com/openimsdk/openim-sdk-core/v3/internal/legacycipher"
+	"github.com/openimsdk/openim-sdk-core/v3/internal/util"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/ccontext"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/constant"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/sdkerrs"
+	"sort"
+)
+
+func legacyConversation(ctx context.Context, message *sdkws.MsgData) string {
+	if message.GroupID != "" {
+		return "sg_" + message.GroupID
+	}
+	pair := []string{message.SendID, message.RecvID}
+	sort.Strings(pair)
+	if pair[0] == "" {
+		pair[0] = ccontext.Info(ctx).UserID()
+		sort.Strings(pair)
+	}
+	return "si_" + pair[0] + "_" + pair[1]
+}
+func (c *LongConnMgr) legacyKey(ctx context.Context, conversation string, version int32) (string, int32, error) {
+	c.legacyKeyMutex.Lock()
+	defer c.legacyKeyMutex.Unlock()
+	if ctx.Err() != nil {
+		return "", 0, sdkerrs.ErrCtxDeadline
+	}
+	if c.legacyKeys == nil {
+		c.legacyKeys = make(map[string]map[int32]string)
+	}
+	keys := c.legacyKeys[conversation]
+	if keys == nil {
+		keys = make(map[int32]string)
+		c.legacyKeys[conversation] = keys
+	}
+	if version > 0 {
+		if key, ok := keys[version]; ok {
+			return key, version, nil
+		}
+	}
+	// Version zero means server-authoritative latest; do not pin it indefinitely.
+	response, err := util.CallApi[encryption.GetEncryptionKeyResp](ctx, "/encryption/get_encryption_key", &encryption.GetEncryptionKeyReq{ConversationID: conversation, KeyVersion: version})
+	if err != nil {
+		return "", 0, err
+	}
+	for _, entry := range response.VersionKeyList {
+		if entry != nil && entry.Version > 0 && len(entry.Key) == 32 {
+			keys[entry.Version] = entry.Key
+		}
+	}
+	if version > 0 {
+		if key, ok := keys[version]; ok {
+			return key, version, nil
+		}
+	} else {
+		var latest int32
+		for candidate := range keys {
+			if candidate > latest {
+				latest = candidate
+			}
+		}
+		if latest > 0 {
+			return keys[latest], latest, nil
+		}
+	}
+	return "", 0, sdkerrs.ErrArgs.Wrap("encryption key unavailable")
+}
+func (c *LongConnMgr) encryptLegacyMessage(ctx context.Context, message *sdkws.MsgData) error {
+	if !c.legacyEncryption.Load() || message.ContentType < constant.Text || message.ContentType >= 1000 {
+		return nil
+	}
+	key, version, err := c.legacyKey(ctx, legacyConversation(ctx, message), 0)
+	if err != nil {
+		return err
+	}
+	encrypted, err := legacycipher.Encrypt(key, message.Content)
+	if err != nil {
+		return sdkerrs.ErrArgs.Wrap("message encryption failed")
+	}
+	message.Content = encrypted
+	message.KeyVersion = version
+	return nil
+}
+func (c *LongConnMgr) decryptLegacyMessages(ctx context.Context, conversations map[string]*sdkws.PullMsgs) error {
+	// Decode the complete batch before committing any content. A missing key or
+	// corrupt item must leave the original wire batch retryable.
+	decoded := make(map[*sdkws.MsgData][]byte)
+	for conversation, pulled := range conversations {
+		if pulled == nil {
+			continue
+		}
+		for _, message := range pulled.Msgs {
+			if message == nil || message.KeyVersion <= 0 {
+				continue
+			}
+			canonical := legacyConversation(ctx, message)
+			if conversation != canonical {
+				return sdkerrs.ErrArgs.Wrap("encrypted conversation mismatch")
+			}
+			key, _, err := c.legacyKey(ctx, canonical, message.KeyVersion)
+			if err != nil {
+				return err
+			}
+			plain, err := legacycipher.Decrypt(key, message.Content)
+			if err != nil || !json.Valid(plain) {
+				return sdkerrs.ErrArgs.Wrap("message decryption failed")
+			}
+			decoded[message] = plain
+		}
+	}
+	if ctx.Err() != nil {
+		return sdkerrs.ErrCtxDeadline
+	}
+	for message, plain := range decoded {
+		message.Content = plain
+	}
+	return nil
+}
