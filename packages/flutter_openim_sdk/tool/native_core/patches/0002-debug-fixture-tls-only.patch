+// Copyright 2026 LuoboIM contributors.
+// SPDX-License-Identifier: Apache-2.0
+
+//go:build luobo_fixture_ca_debug
+
+package fixturetls
+
+import (
+	"crypto/tls"
+	"net/http"
+	"testing"
+)
+
+func TestCompiledQAClientIsPrivateAndCannotRedirect(t *testing.T) {
+	originalConfig := &tls.Config{MinVersion: tls.VersionTLS13}
+	baseTransport := &http.Transport{TLSClientConfig: originalConfig}
+	client := &http.Client{Transport: baseTransport}
+	copy, err := ClientForURL(client, "https://10.0.2.2:34443/api/test")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if copy == client || copy.Transport == baseTransport {
+		t.Fatal("QA changed a shared client or transport")
+	}
+	if baseTransport.TLSClientConfig != originalConfig || originalConfig.RootCAs != nil || originalConfig.InsecureSkipVerify || originalConfig.MinVersion != tls.VersionTLS13 {
+		t.Fatal("original transport trust changed")
+	}
+	transport := copy.Transport.(*http.Transport)
+	if transport.TLSClientConfig == nil || transport.TLSClientConfig.InsecureSkipVerify || transport.Proxy != nil {
+		t.Fatal("invalid private QA transport")
+	}
+	if copy.CheckRedirect(nil, nil) != http.ErrUseLastResponse {
+		t.Fatal("QA client may follow redirect")
+	}
+	other, err := ClientForURL(client, "https://other.fixture.test:34443/api/test")
+	if err != nil || other != client {
+		t.Fatal("QA trust applied to a different origin")
+	}
+}
