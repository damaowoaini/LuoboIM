diff --git a/pkg/fixturetls/config.go b/pkg/fixturetls/config.go
new file mode 100644
--- /dev/null
+++ b/pkg/fixturetls/config.go
@@ -0,0 +1,87 @@
+// Copyright 2026 LuoboIM contributors.
+// SPDX-License-Identifier: Apache-2.0
+
+// Package fixturetls contains only the explicitly compiled QA trust boundary.
+// It never changes system roots, environment variables, or global transports.
+package fixturetls
+
+import (
+	"crypto/sha256"
+	"crypto/tls"
+	"crypto/x509"
+	"encoding/hex"
+	"encoding/pem"
+	"errors"
+	"net/http"
+	"net/url"
+	"path"
+	"strings"
+	"time"
+)
+
+func allowed(raw string) bool {
+	u, err := url.Parse(raw)
+	if err != nil || u.Host != "10.0.2.2:34443" || u.User != nil || u.Fragment != "" || u.RawPath != "" {
+		return false
+	}
+	if strings.TrimSuffix(u.Path, "/") != path.Clean(u.Path) {
+		return false
+	}
+	if u.Scheme == "https" {
+		return (u.Path == "/api" || strings.HasPrefix(u.Path, "/api/")) && u.RawQuery == "" && !u.ForceQuery
+	}
+	// The SDK adds its normal authenticated WebSocket query after initSDK.
+	return u.Scheme == "wss" && u.Path == "/msg_gateway"
+}
+
+func configFromPEM(raw string, ca []byte, expectedSHA string) (*tls.Config, error) {
+	if !allowed(raw) {
+		return nil, nil
+	}
+	sum := sha256.Sum256(ca)
+	if len(ca) == 0 || len(ca) > 32768 || hex.EncodeToString(sum[:]) != expectedSHA {
+		return nil, errors.New("QA CA checksum mismatch")
+	}
+	block, rest := pem.Decode(ca)
+	if block == nil || block.Type != "CERTIFICATE" || len(strings.TrimSpace(string(rest))) != 0 {
+		return nil, errors.New("QA CA must contain exactly one certificate")
+	}
+	certificate, err := x509.ParseCertificate(block.Bytes)
+	if err != nil || !certificate.IsCA || !certificate.BasicConstraintsValid || certificate.KeyUsage&x509.KeyUsageCertSign == 0 {
+		return nil, errors.New("QA CA is invalid")
+	}
+	now := time.Now()
+	if now.Before(certificate.NotBefore) || now.After(certificate.NotAfter) {
+		return nil, errors.New("QA CA validity period rejected")
+	}
+	roots, err := x509.SystemCertPool()
+	if err != nil {
+		return nil, errors.New("standard system roots unavailable")
+	}
+	roots.AddCert(certificate)
+	return &tls.Config{RootCAs: roots, MinVersion: tls.VersionTLS12}, nil
+}
+
+// ClientForURL returns the original client unless a compiled QA override applies.
+// Its copy has a private transport, direct fixture routing and no redirects.
+func ClientForURL(client *http.Client, raw string) (*http.Client, error) {
+	config, err := ConfigForURL(raw)
+	if err != nil || config == nil {
+		return client, err
+	}
+	base := client.Transport
+	if base == nil {
+		base = http.DefaultTransport
+	}
+	transport, ok := base.(*http.Transport)
+	if !ok {
+		return nil, errors.New("QA transport cannot be cloned")
+	}
+	copy := *client
+	privateTransport := transport.Clone()
+	privateTransport.TLSClientConfig = config
+	privateTransport.Proxy = nil
+	copy.Transport = privateTransport
+	copy.CheckRedirect = func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse }
+	return &copy, nil
+}
