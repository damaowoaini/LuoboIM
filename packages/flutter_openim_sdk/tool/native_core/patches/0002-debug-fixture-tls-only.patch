+//go:build !luobo_fixture_ca_debug
+
+package fixturetls
+
+import (
+	"net/http"
+	"testing"
+)
+
+func TestDefaultBuildDoesNotOverrideAnyTrust(t *testing.T) {
+	client := &http.Client{}
+	for _, raw := range []string{"https://10.0.2.2:34443/api/test", "wss://10.0.2.2:34443/msg_gateway", "https://public.example/api/test"} {
+		config, err := ConfigForURL(raw)
+		if err != nil || config != nil {
+			t.Fatal("default build added fixture trust")
+		}
+		copy, err := ClientForURL(client, raw)
+		if err != nil || copy != client {
+			t.Fatal("default build altered the caller's HTTP client")
+		}
+	}
+}
diff --git a/pkg/fixturetls/config_test.go b/pkg/fixturetls/config_test.go
new file mode 100644
--- /dev/null
+++ b/pkg/fixturetls/config_test.go
@@ -0,0 +1,196 @@
+// Copyright 2026 LuoboIM contributors.
+// SPDX-License-Identifier: Apache-2.0
+
+package fixturetls
+
+import (
+	"context"
+	"crypto/ecdsa"
+	"crypto/elliptic"
+	"crypto/rand"
+	"crypto/sha256"
+	"crypto/tls"
+	"crypto/x509"
+	"crypto/x509/pkix"
+	"encoding/hex"
+	"encoding/pem"
+	"io"
+	"log"
+	"math/big"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+	"time"
+
+	"github.com/gorilla/websocket"
+)
+
+type syntheticPKI struct {
+	caPEM  []byte
+	caHash string
+	leaf   tls.Certificate
+}
+
+func makePKI(t *testing.T, wrongIP, expired bool) syntheticPKI {
+	t.Helper()
+	caKey, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	now := time.Now()
+	ca := &x509.Certificate{SerialNumber: big.NewInt(1), Subject: pkix.Name{CommonName: "synthetic QA test CA"}, IsCA: true, BasicConstraintsValid: true, KeyUsage: x509.KeyUsageCertSign, NotBefore: now.Add(-24 * time.Hour), NotAfter: now.Add(24 * time.Hour)}
+	caDER, err := x509.CreateCertificate(rand.Reader, ca, ca, &caKey.PublicKey, caKey)
+	if err != nil {
+		t.Fatal(err)
+	}
+	caPEM := pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: caDER})
+	leafKey, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	ip := net.ParseIP("10.0.2.2")
+	if wrongIP {
+		ip = net.ParseIP("127.0.0.1")
+	}
+	leaf := &x509.Certificate{SerialNumber: big.NewInt(2), Subject: pkix.Name{CommonName: "synthetic server"}, KeyUsage: x509.KeyUsageDigitalSignature, ExtKeyUsage: []x509.ExtKeyUsage{x509.ExtKeyUsageServerAuth}, IPAddresses: []net.IP{ip}, NotBefore: now.Add(-2 * time.Hour), NotAfter: now.Add(time.Hour)}
+	if expired {
+		leaf.NotAfter = now.Add(-time.Hour)
+	}
+	leafDER, err := x509.CreateCertificate(rand.Reader, leaf, ca, &leafKey.PublicKey, caKey)
+	if err != nil {
+		t.Fatal(err)
+	}
+	keyDER, err := x509.MarshalECPrivateKey(leafKey)
+	if err != nil {
+		t.Fatal(err)
+	}
+	keyPair, err := tls.X509KeyPair(pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: leafDER}), pem.EncodeToMemory(&pem.Block{Type: "EC PRIVATE KEY", Bytes: keyDER}))
+	if err != nil {
+		t.Fatal(err)
+	}
+	sum := sha256.Sum256(caPEM)
+	return syntheticPKI{caPEM, hex.EncodeToString(sum[:]), keyPair}
+}
+
+func syntheticServer(t *testing.T, pki syntheticPKI, handler http.Handler) *httptest.Server {
+	t.Helper()
+	server := httptest.NewUnstartedServer(handler)
+	server.Config.ErrorLog = log.New(io.Discard, "", 0)
+	server.TLS = &tls.Config{Certificates: []tls.Certificate{pki.leaf}, MinVersion: tls.VersionTLS12}
+	server.StartTLS()
+	t.Cleanup(server.Close)
+	return server
+}
+
+func dialLocal(server *httptest.Server) func(context.Context, string, string) (net.Conn, error) {
+	return func(ctx context.Context, _, _ string) (net.Conn, error) {
+		return (&net.Dialer{}).DialContext(ctx, "tcp", server.Listener.Addr().String())
+	}
+}
+
+func TestScopedCertificateIsActuallyVerifiedForHTTPAndWSS(t *testing.T) {
+	for _, sample := range []struct {
+		name                                    string
+		wrongIP, expired, wrongCA, noCustomRoot bool
+	}{
+		{name: "matching CA and IP"}, {name: "no custom root", noCustomRoot: true}, {name: "wrong CA", wrongCA: true}, {name: "wrong SAN", wrongIP: true}, {name: "expired certificate", expired: true},
+	} {
+		t.Run(sample.name, func(t *testing.T) {
+			pki := makePKI(t, sample.wrongIP, sample.expired)
+			trust := pki
+			if sample.wrongCA {
+				trust = makePKI(t, false, false)
+			}
+			server := syntheticServer(t, pki, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if r.URL.Path == "/msg_gateway" {
+					conn, err := (&websocket.Upgrader{}).Upgrade(w, r, nil)
+					if err != nil {
+						return
+					}
+					defer conn.Close()
+					_ = conn.SetReadDeadline(time.Now().Add(3 * time.Second))
+					kind, payload, err := conn.ReadMessage()
+					if err == nil {
+						_ = conn.WriteMessage(kind, payload)
+					}
+					return
+				}
+				_, _ = io.WriteString(w, "synthetic-ok")
+			}))
+			config, err := configFromPEM("https://10.0.2.2:34443/api/probe", trust.caPEM, trust.caHash)
+			if err != nil || config == nil {
+				t.Fatalf("prepare config: %v", err)
+			}
+			if sample.noCustomRoot {
+				config = &tls.Config{MinVersion: tls.VersionTLS12}
+			}
+			if config.InsecureSkipVerify || config.ServerName != "" {
+				t.Fatal("normal hostname and chain verification must be preserved")
+			}
+			client := &http.Client{Timeout: 3 * time.Second, Transport: &http.Transport{TLSClientConfig: config, DialContext: dialLocal(server)}}
+			response, httpErr := client.Get("https://10.0.2.2:34443/api/probe")
+			if response != nil {
+				defer response.Body.Close()
+			}
+			wsConfig, err := configFromPEM("wss://10.0.2.2:34443/msg_gateway?token=synthetic", trust.caPEM, trust.caHash)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if sample.noCustomRoot {
+				wsConfig = &tls.Config{MinVersion: tls.VersionTLS12}
+			}
+			dialer := websocket.Dialer{TLSClientConfig: wsConfig, NetDialContext: dialLocal(server), HandshakeTimeout: 3 * time.Second}
+			conn, _, wsErr := dialer.Dial("wss://10.0.2.2:34443/msg_gateway?token=synthetic", nil)
+			valid := !sample.wrongIP && !sample.expired && !sample.wrongCA && !sample.noCustomRoot
+			if !valid {
+				if httpErr == nil || wsErr == nil {
+					t.Fatal("invalid certificate must fail HTTP and WebSocket")
+				}
+				return
+			}
+			if httpErr != nil || wsErr != nil {
+				t.Fatalf("valid chain rejected; HTTP:%v WSS:%v", httpErr, wsErr)
+			}
+			defer conn.Close()
+			body, err := io.ReadAll(response.Body)
+			if err != nil || string(body) != "synthetic-ok" {
+				t.Fatal("HTTP fixture body mismatch")
+			}
+			if err = conn.WriteMessage(websocket.TextMessage, []byte("bounded-frame")); err != nil {
+				t.Fatal(err)
+			}
+			_ = conn.SetReadDeadline(time.Now().Add(3 * time.Second))
+			_, payload, err := conn.ReadMessage()
+			if err != nil || string(payload) != "bounded-frame" {
+				t.Fatal("WebSocket fixture frame mismatch")
+			}
+		})
+	}
+}
+
+func TestNonFixtureOriginsNeverReceiveExtraRoot(t *testing.T) {
+	pki := makePKI(t, false, false)
+	for _, raw := range []string{"http://10.0.2.2:34443/api/test", "https://10.0.2.2/api/test", "https://10.0.2.2:34444/api/test", "https://other.fixture.test:34443/api/test", "https://user@10.0.2.2:34443/api/test", "https://10.0.2.2:34443/api/test?token=synthetic", "https://10.0.2.2:34443/object/item", "wss://10.0.2.2:34443/other", "https://10.0.2.2:34443/api/test#fragment", "https://10.0.2.2:34443/api/../admin", "https://10.0.2.2:34443/api//user", "https://10.0.2.2:34443/api/./user", "https://10.0.2.2:34443/api/test?"} {
+		config, err := configFromPEM(raw, pki.caPEM, pki.caHash)
+		if err != nil || config != nil {
+			t.Fatalf("extra trust escaped fixture origin/path: %q", raw)
+		}
+	}
+}
+
+func TestInvalidPinOrPEMIsFailClosed(t *testing.T) {
+	pki := makePKI(t, false, false)
+	invalidPEM := []byte("not PEM")
+	invalidSum := sha256.Sum256(invalidPEM)
+	twoPEM := append(append([]byte{}, pki.caPEM...), pki.caPEM...)
+	twoSum := sha256.Sum256(twoPEM)
+	for _, input := range []struct {
+		ca   []byte
+		hash string
+	}{{pki.caPEM, "wrong"}, {invalidPEM, hex.EncodeToString(invalidSum[:])}, {twoPEM, hex.EncodeToString(twoSum[:])}} {
+		if _, err := configFromPEM("https://10.0.2.2:34443/api/test", input.ca, input.hash); err == nil {
+			t.Fatal("invalid fixture CA accepted")
+		}
+	}
+}
