{
  "name": "luobo-duihua-web",
  "version": "1.0.0",
  "main": "dist-electron/main/index.js",
  "description": "萝卜对话 Web 与桌面客户端",
  "author": "blooming",
  "private": true,
  "debug": {
    "env": {
      "VITE_DEV_SERVER_URL": "http://127.0.0.1:7777/"
    }
  },
  "scripts": {
    "dev": "vite --config vite.web.config.mts --host 127.0.0.1",
    "build": "vite build --config vite.web.config.mts",
    "preview": "vite preview --config vite.web.config.mts --host 127.0.0.1",
    "build:mac": "vite build  &&  electron-builder --macos --x64",
    "build:mac-arm": "vite build  &&  electron-builder --macos --arm64",
    "build:win": "vite build  &&  electron-builder --win --x64",
    "build:win-arm": "vite build  &&  electron-builder --win --arm64",
    "build:linux": "vite build  &&  electron-builder --linux --x64",
    "build:linux-arm": "vite build  &&  electron-builder --linux --arm64",
    "generate-icons": "node generate_icons_simple.js",
    "generate-icons-advanced": "node generate_icons.js",
    "pree2e": "vite build --mode=test",
    "e2e": "playwright test",
    "format": "prettier --write .",
    "lint": "eslint --ext .js,.jsx,.ts,.tsx src",
    "lint:fix": "eslint --ext .js,.jsx,.ts,.tsx --fix --quiet src",
    "build:web": "vite build --config vite.web.config.mts",
    "build:desktop": "vite build --config vite.config.mts && electron-builder",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:desktop": "tsc --noEmit -p tsconfig.desktop.json",
    "build:desktop:code": "vite build --config vite.config.mts",
    "prepare:sdk": "node tool/prepare-sdk.cjs",
    "predev": "npm run prepare:sdk",
    "prebuild": "npm run prepare:sdk",
    "prebuild:web": "npm run prepare:sdk",
    "prebuild:desktop": "npm run prepare:sdk",
    "prebuild:desktop:code": "npm run prepare:sdk",
    "prebuild:mac": "npm run prepare:sdk",
    "prebuild:mac-arm": "npm run prepare:sdk",
    "prebuild:win": "npm run prepare:sdk",
    "prebuild:win-arm": "npm run prepare:sdk",
    "prebuild:linux": "npm run prepare:sdk",
    "prebuild:linux-arm": "npm run prepare:sdk"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "build": {
    "extends": null,
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "directories": {
      "output": "package"
    },
    "productName": "萝卜对话",
    "win": {
      "icon": "./dist/icons/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "./dist/icons/icon.png"
    },
    "linux": {
      "icon": "./dist/icons/icon.png",
      "target": "deb",
      "maintainer": "openim-cer"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "萝卜对话",
      "installerIcon": "./dist/icons/icon.ico",
      "uninstallerIcon": "./dist/icons/icon.ico",
      "installerHeaderIcon": "./dist/icons/icon.ico"
    },
    "asar": true,
    "extraResources": {
      "from": "./extraResources/",
      "to": "extraResources"
    },
    "appId": "com.luoboduihua.imapp"
  },
  "lint-staged": {
    "src/**/*.{tsx,ts}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,html,css,scss,xml,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/dompurify": "^3.2.0",
    "@types/md5": "^2.3.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "^5.53.0",
    "@typescript-eslint/parser": "^5.53.0",
    "@vitejs/plugin-legacy": "8.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "autoprefixer": "^10.4.13",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "eslint": "^8.34.0",
    "eslint-config-prettier": "^8.6.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-simple-import-sort": "^10.0.0",
    "jsdom": "30.1.2",
    "lint-staged": "^13.1.2",
    "patch-package": "^8.0.0",
    "postcss": "^8.4.21",
    "prettier": "^2.8.4",
    "prettier-plugin-tailwindcss": "^0.2.3",
    "rollup-plugin-visualizer": "^5.9.2",
    "sass": "^1.58.3",
    "tailwindcss": "^3.2.7",
    "terser": "^5.19.0",
    "typescript": "^7.0.2",
    "vite": "8.3.4",
    "vite-plugin-electron": "^1.1.2",
    "vitest": "5.0.4"
  },
  "dependencies": {
    "@ant-design/icons": "^5.1.4",
    "@ant-design/v5-patch-for-react-19": "1.0.3",
    "@livekit/components-react": "2.9.24",
    "@livekit/components-styles": "1.2.0",
    "@tanstack/react-query": "5.104.2",
    "adm-zip": "0.6.1",
    "ahooks": "^3.7.7",
    "antd": "^5.6.0",
    "axios": "^1.4.0",
    "clsx": "^1.2.1",
    "date-fns": "^2.30.0",
    "dayjs": "^1.11.7",
    "dompurify": "^3.3.3",
    "electron-log": "^5.0.0",
    "electron-screenshots": "^0.5.23",
    "electron-store": "^8.1.0",
    "electron-updater": "6.8.9",
    "emoji-picker-element": "^1.18.3",
    "i18next": "^22.5.0",
    "i18next-browser-languagedetector": "^7.0.2",
    "i18next-fs-backend": "^2.2.0",
    "livekit-client": "2.22.4",
    "localforage": "^1.10.0",
    "md5": "^2.3.0",
    "mitt": "^3.0.0",
    "open-im-sdk-wasm": "3.5.1-alpha.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-draggable": "^4.4.5",
    "react-i18next": "^12.3.1",
    "react-image-file-resizer": "^0.4.8",
    "react-infinite-scroll-component-two-way": "^6.1.1",
    "react-router-dom": "7.18.4",
    "react-use": "^17.4.0",
    "react-virtuoso": "^4.3.8",
    "twemoji": "14.0.1",
    "uuid": "14.0.3",
    "xgplayer": "^3.0.5",
    "zustand": "^4.3.3"
  }
}
