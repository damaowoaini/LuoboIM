# Configure a dedicated HTTPS map origin. Leave unconfigured until the project's
# domain-restricted AMap Web(JSAPI) key and server security code are available.
# Do not commit a populated environment file or use the historical App's key.
LUOBO_MAP_ORIGIN=
LUOBO_AMAP_JS_KEY=
LUOBO_AMAP_SECURITY_CODE=
LUOBO_MAP_PORT=8089
