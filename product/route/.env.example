# Copy values into your deployment secret store; do not commit a real .env file.
# Bind loopback behind your TLS proxy. Empty retains legacy all-interface binding.
# Accepts an IP (IPv4/IPv6) or localhost, never an arbitrary hostname/URL.
ROUTE_LISTEN_HOST=127.0.0.1
ROUTE_PORT=10010
ROUTE_MYSQL_HOST=127.0.0.1
ROUTE_MYSQL_PORT=3306
ROUTE_MYSQL_USER=luobo_route
ROUTE_MYSQL_PASSWORD=
ROUTE_MYSQL_DATABASE=openim_route
ROUTE_ADMIN_TOKEN=
# Comma-separated CIDRs of actual reverse proxies. Empty trusts no proxy.
ROUTE_TRUSTED_PROXIES=
# Exact HTTPS origins; empty allows native clients and same-origin browser use.
ROUTE_ALLOWED_ORIGINS=
ROUTE_AUTH_PER_MINUTE=60
ROUTE_VERIFY_PER_MINUTE=6
# Optional operational Redis connection; tenant chart owns all public OTPs.
ROUTE_REDIS_ADDRESS=
ROUTE_REDIS_PASSWORD=
ROUTE_REDIS_DB=0

# JSON map of server IDs to independent chart LUOBO_ROUTE_SHARED_SECRET values.
# Every value must be at least 32 characters; no real secret belongs here.
ROUTE_UPSTREAM_SECRETS={}
# Optional single-secret fallback for an intentionally single-tenant deployment.
LUOBO_ROUTE_SHARED_SECRET=
